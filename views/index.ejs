<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Rahma Pearl Girls PG provides safe, comfortable and premium accommodation for students and working women in Sattur, Dharwad."
    >

    <title>Rahma Pearl Girls PG - Premium Living</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        :root {
            --primary-color: #6c5ce7;
            --primary-dark: #5649d8;
            --secondary-color: #a29bfe;
            --accent-color: #fd79a8;
            --dark-color: #202332;
            --light-color: #f8f9ff;
            --text-color: #5f6675;
            --white-color: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Poppins", sans-serif;
            color: var(--dark-color);
            overflow-x: hidden;
            background: var(--white-color);
        }

        a {
            text-decoration: none;
        }

        img {
            max-width: 100%;
        }

        section {
            scroll-margin-top: 85px;
        }

        /* =========================
           NAVBAR
        ========================== */

        .navbar {
            background: rgba(255, 255, 255, 0.97);
            box-shadow: 0 2px 18px rgba(0, 0, 0, 0.08);
            padding: 13px 0;
            transition: 0.3s ease;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--primary-color) !important;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            background: linear-gradient(
                135deg,
                var(--primary-color),
                var(--accent-color)
            );
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3);
        }

        .navbar-nav {
            align-items: center;
            gap: 5px;
        }

        .nav-link {
            color: #34384a !important;
            font-size: 14px;
            font-weight: 600;
            padding: 10px 13px !important;
            border-radius: 8px;
            transition: 0.3s;
        }

        .nav-link:hover {
            color: var(--primary-color) !important;
            background: rgba(108, 92, 231, 0.08);
        }

        .navbar-toggler {
            border: none;
            box-shadow: none !important;
        }

        .login-button {
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
            padding: 9px 24px;
            border-radius: 30px;
            font-weight: 600;
            transition: 0.3s;
        }

        .login-button:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }

        /* =========================
           HERO SECTION
        ========================== */

        .hero-section {
            position: relative;
            min-height: 91vh;
            display: flex;
            align-items: center;
            color: white;
            background:
                linear-gradient(
                    110deg,
                    rgba(21, 24, 40, 0.88),
                    rgba(75, 58, 145, 0.68)
                ),
                url("https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=1600&q=85");

            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -140px;
            right: -100px;
        }

        .hero-section::after {
            content: "";
            position: absolute;
            width: 290px;
            height: 290px;
            border-radius: 50%;
            background: rgba(253, 121, 168, 0.15);
            left: -100px;
            bottom: -120px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 780px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 9px 17px;
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            margin-bottom: 24px;
            font-size: 14px;
            font-weight: 600;
        }

        .hero-title {
            font-size: clamp(44px, 6vw, 76px);
            line-height: 1.1;
            font-weight: 800;
            margin-bottom: 22px;
        }

        .hero-title span {
            color: #d8d4ff;
        }

        .hero-description {
            max-width: 680px;
            font-size: 18px;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.86);
            margin-bottom: 34px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(
                135deg,
                var(--primary-color),
                var(--accent-color)
            );
            color: white;
            padding: 14px 29px;
            border-radius: 35px;
            font-weight: 700;
            transition: 0.3s;
            box-shadow: 0 12px 26px rgba(108, 92, 231, 0.35);
        }

        .primary-button:hover {
            color: white;
            transform: translateY(-4px);
            box-shadow: 0 18px 35px rgba(108, 92, 231, 0.42);
        }

        .outline-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.75);
            padding: 12px 27px;
            border-radius: 35px;
            font-weight: 700;
            transition: 0.3s;
        }

        .outline-button:hover {
            color: var(--primary-color);
            background: white;
            border-color: white;
            transform: translateY(-4px);
        }

        .hero-stats {
            margin-top: 52px;
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .hero-stat {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .hero-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.15);
            font-size: 20px;
        }

        .hero-stat h5 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
        }

        .hero-stat p {
            margin: 2px 0 0;
            color: rgba(255, 255, 255, 0.72);
            font-size: 13px;
        }

        /* =========================
           COMMON SECTION STYLES
        ========================== */

        .section-padding {
            padding: 90px 0;
        }

        .section-label {
            display: inline-block;
            color: var(--primary-color);
            background: rgba(108, 92, 231, 0.1);
            padding: 8px 15px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .section-title {
            font-size: clamp(32px, 4vw, 47px);
            font-weight: 800;
            line-height: 1.25;
            margin-bottom: 16px;
        }

        .section-description {
            color: var(--text-color);
            font-size: 16px;
            line-height: 1.8;
        }

        /* =========================
           ABOUT SECTION
        ========================== */

        .about-section {
            background: var(--white-color);
        }

        .about-image-wrapper {
            position: relative;
            padding: 20px 20px 20px 0;
        }

        .about-main-image {
            width: 100%;
            height: 520px;
            object-fit: cover;
            border-radius: 26px;
            box-shadow: 0 22px 55px rgba(33, 37, 65, 0.16);
        }

        .about-image-wrapper::before {
            content: "";
            position: absolute;
            width: 82%;
            height: 88%;
            left: -18px;
            bottom: 0;
            border-radius: 25px;
            background: linear-gradient(
                135deg,
                var(--secondary-color),
                var(--accent-color)
            );
            z-index: -1;
        }

        .about-experience-card {
            position: absolute;
            right: -5px;
            bottom: 55px;
            background: white;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 14px 40px rgba(28, 32, 57, 0.18);
            min-width: 190px;
        }

        .about-experience-card i {
            color: var(--primary-color);
            font-size: 30px;
            margin-bottom: 10px;
        }

        .about-experience-card h4 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 2px;
        }

        .about-experience-card p {
            margin: 0;
            color: var(--text-color);
            font-size: 13px;
        }

        .about-content {
            padding-left: 25px;
        }

        .about-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin: 30px 0;
        }

        .about-list-item {
            display: flex;
            align-items: center;
            gap: 11px;
            font-weight: 600;
            color: #35394b;
        }

        .about-list-item i {
            width: 31px;
            height: 31px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(108, 92, 231, 0.12);
            color: var(--primary-color);
            font-size: 13px;
        }

        /* =========================
           FEATURES SECTION
        ========================== */

        .features-section {
            background: linear-gradient(
                180deg,
                #f9f9ff,
                #f2f1ff
            );
        }

        .feature-card {
            height: 100%;
            background: white;
            padding: 34px 28px;
            border-radius: 20px;
            border: 1px solid rgba(108, 92, 231, 0.08);
            transition: 0.35s;
            box-shadow: 0 8px 25px rgba(36, 40, 70, 0.06);
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 44px rgba(43, 47, 82, 0.14);
            border-color: rgba(108, 92, 231, 0.22);
        }

        .feature-icon-box {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 19px;
            margin-bottom: 23px;
            font-size: 29px;
            color: white;
            background: linear-gradient(
                135deg,
                var(--primary-color),
                var(--secondary-color)
            );
            box-shadow: 0 11px 24px rgba(108, 92, 231, 0.25);
        }

        .feature-card:nth-child(even) .feature-icon-box {
            background: linear-gradient(
                135deg,
                #fd79a8,
                #e84393
            );
        }

        .feature-card h4 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .feature-card p {
            color: var(--text-color);
            line-height: 1.75;
            margin-bottom: 0;
            font-size: 14px;
        }

        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 991px) {
            .navbar-nav {
                align-items: flex-start;
                padding-top: 15px;
            }

            .login-button {
                margin-top: 8px;
                display: inline-block;
            }

            .hero-section {
                min-height: 85vh;
                text-align: center;
            }

            .hero-content {
                margin: auto;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .hero-stats {
                justify-content: center;
            }

            .about-content {
                padding-left: 0;
                padding-top: 50px;
            }
        }

        @media (max-width: 767px) {
            .section-padding {
                padding: 70px 0;
            }

            .hero-title {
                font-size: 44px;
            }

            .hero-description {
                font-size: 16px;
            }

            .hero-stats {
                gap: 20px;
            }

            .hero-stat {
                width: 100%;
                justify-content: center;
            }

            .about-main-image {
                height: 420px;
            }

            .about-experience-card {
                right: 5px;
                bottom: 40px;
            }

            .about-list {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {
            .hero-title {
                font-size: 38px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .primary-button,
            .outline-button {
                width: 100%;
            }

            .about-main-image {
                height: 350px;
            }

            .about-experience-card {
                position: relative;
                right: auto;
                bottom: auto;
                margin: -40px 20px 0;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
