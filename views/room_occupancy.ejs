<!DOCTYPE html>
<html>

<head>

<title>Room Occupancy</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:#f4f6f9;
font-family:Arial;
padding:40px;
}

.room-card{
color:white;
padding:25px;
margin:10px;
border-radius:12px;
text-align:center;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
transition:0.3s;
}

.room-card:hover{
transform:scale(1.05);
}

</style>

</head>

<body class="container">

<h2 class="mb-4">Room Occupancy Status</h2>

<div class="row">

<% rooms.forEach(room => { 

let available = room.total_beds - room.occupied_beds;
let color = "green";

if(available == 0) color="red";
else if(available == 1) color="orange";

%>

<div class="col-md-3">

<div 
class="room-card"
style="background:<%= color %>;"
>

<h4>Room <%= room.room_number %></h4>

<p>Total Beds: <%= room.total_beds %></p>

<p>Occupied Beds: <%= room.occupied_beds %></p>

<p><b>Available Beds: <%= available %></b></p>

</div>

</div>

<% }) %>

</div>
data: {
  labels: [<%= rooms.map(r => `"Room ${r.room_number}"`).join(",") %>],
  datasets: [
    {
      label: 'Occupied Beds',
      data: [<%= rooms.map(r => r.occupied_beds).join(",") %>],
      backgroundColor: '#2ecc71'
    },
    {
      label: 'Vacant Beds',
      data: [<%= rooms.map(r => r.total_beds - r.occupied_beds).join(",") %>],
      backgroundColor: '#e74c3c'
    }
  ]
}
options: {
  plugins: {
    tooltip: { enabled: true }
  }
}
</body>

</html>