<!DOCTYPE html>
<html>
<head>
<title>Staff Management</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background:#f4f6f9;padding:40px">

<div class="container">
<div class="card p-4 shadow">

<div class="d-flex justify-content-between align-items-center mb-4">
<h3>Staff Management</h3>
<a href="/admin/dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

<form action="/admin/staff/add" method="POST" class="row g-2 mb-4">
<div class="col-md-3"><input name="name" class="form-control" placeholder="Name" required></div>
<div class="col-md-3"><input name="role" class="form-control" placeholder="Role" required></div>
<div class="col-md-2"><input name="phone" class="form-control" placeholder="Phone" required></div>
<div class="col-md-2"><input name="salary" type="number" class="form-control" placeholder="Salary" required></div>
<div class="col-md-2"><button class="btn btn-primary w-100">Add Staff</button></div>
</form>

<table class="table table-bordered table-hover align-middle">
<thead class="table-dark">
<tr>
<th>Name</th>
<th>Role</th>
<th>Contact</th>
<th>Salary</th>
<th>Payment</th>
<th style="width:260px;">Actions</th>
</tr>
</thead>

<tbody>
<% if (staff && staff.length > 0) { %>
<% staff.forEach(member => { %>
<tr>
<td><%= member.name %></td>
<td><%= member.role %></td>
<td><%= member.phone %></td>
<td>₹<%= member.salary || 0 %></td>

<td>
<% if(member.payment_status === "Paid"){ %>
<span class="badge bg-success">Paid</span>
<% } else { %>
<span class="badge bg-danger">Unpaid</span>
<% } %>
</td>

<td>
<a href="/admin/staff/payment/<%= member.id %>/Paid" class="btn btn-success btn-sm">Paid</a>
<a href="/admin/staff/payment/<%= member.id %>/Unpaid" class="btn btn-warning btn-sm">Unpaid</a>
<a href="/admin/staff/edit/<%= member.id %>" class="btn btn-primary btn-sm">Edit</a>

<form action="/admin/staff/delete/<%= member.id %>" method="POST" style="display:inline;">
<button class="btn btn-danger btn-sm" onclick="return confirm('Delete staff?')">Delete</button>
</form>
</td>
</tr>
<% }) %>
<% } else { %>
<tr>
<td colspan="6" class="text-center">No staff found</td>
</tr>
<% } %>
</tbody>
</table>

</div>
</div>

</body>
</html>