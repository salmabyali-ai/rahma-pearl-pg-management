<!DOCTYPE html>
<html>
<head>
<title>Payments</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">

<h2>Payment Approval</h2>

<table class="table table-bordered">

<tr>
<th>ID</th>
<th>Student</th>
<th>Amount</th>
<th>Status</th>
<th>Screenshot</th>
<th>Action</th>
</tr>

<% payments.forEach(p => { %>

<tr>
<td><%= p.id %></td>
<td><%= p.student_email %></td>
<td>₹ <%= p.amount %></td>
<td><%= p.status %></td>

<td>
<a href="/uploads/<%= p.screenshot %>" target="_blank">
View
</a>
</td>

<td>

<form action="/admin/payment/approve/<%= p.id %>" method="POST">

<button class="btn btn-success">
Approve
</button>

</form>
<form action="/admin/payment/reject/<%= p.id %>" method="POST">
    <button class="btn btn-danger mt-1">Reject</button>
</form>

</td>

</tr>

<% }) %>

</table>

</body>
</html>