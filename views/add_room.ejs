<!DOCTYPE html>
<html>
<head>
    <title>Add Room</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body style="padding:20px; font-family:Arial;">

<h2>Add Room</h2>

<form method="POST" action="/add-room">

<label>Room Number:</label><br>
<input type="text" name="room_number" placeholder="Room Number" required><br><br>

<label>Capacity:</label><br>
<input type="number" name="capacity" placeholder="Capacity" required><br><br>

<label>Price:</label><br>
<input type="number" name="price" placeholder="Room Rent Price" required><br><br>

<button type="submit">Add Room</button>

</form>

<br>
<a href="/admin/dashboard">Back</a>

</body>
</html>