<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mess Student Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f4f6f9;
            min-height: 100vh;
            padding: 40px 15px;
        }

        .dashboard-card {
            border: none;
            border-radius: 18px;
        }

        .dashboard-header {
            background: linear-gradient(
                135deg,
                #198754,
                #20c997
            );
            color: white;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 25px;
        }

        .info-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 18px;
            height: 100%;
        }

        .info-card p {
            margin-bottom: 10px;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 18px;
        }

        .table th {
            background: #198754;
            color: white;
            text-align: center;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
        }

        .meal-option {
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card dashboard-card shadow p-4">

        <div class="dashboard-header">
            <h2 class="mb-1">Mess Student Dashboard</h2>

            <p class="mb-0">
                Welcome,
                <strong>
                    <%= mess && mess.name
                        ? mess.name
                        : "Mess Student" %>
                </strong>
            </p>
        </div>

        <!-- Student Information -->

        <h4 class="section-title">
            My Details
        </h4>

        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="info-card">
                    <p>
                        <strong>Name:</strong>

                        <%= mess && mess.name
                            ? mess.name
                            : "Not available" %>
                    </p>

                    <p>
                        <strong>Phone:</strong>

                        <%= mess && mess.phone
                            ? mess.phone
                            : "Not available" %>
                    </p>

                    <p>
                        <strong>Email:</strong>

                        <%= mess && mess.email
                            ? mess.email
                            : "Not available" %>
                    </p>

                    <p>
                        <strong>Meal Type:</strong>

                        <%= mess && mess.meal_type
                            ? mess.meal_type
                            : "Not selected" %>
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <%
                     let amount = 0;

                     if (mess) {
    switch (mess.meal_type) {
        case "Full Day":
            amount = 3000;
            break;

        case "Breakfast":
            amount = 1000;
            break;

        case "Lunch":
            amount = 1200;
            break;

        case "Dinner":
            amount = 1200;
            break;

        case "Lunch and Dinner":
            amount = 2200;
            break;

        default:
            amount = 0;
    }
}
%>

<p>
    <strong>Amount:</strong>
    ₹<%= amount %>
</p>
                    
                    <p>
                        <strong>From Date:</strong>

                        <% if (mess && mess.from_date) { %>
                            <%= new Date(
                                mess.from_date
                            ).toLocaleDateString("en-IN") %>
                        <% } else { %>
                            Not available
                        <% } %>
                    </p>

                    <p>
                        <strong>To Date:</strong>

                        <% if (mess && mess.to_date) { %>
                            <%= new Date(
                                mess.to_date
                            ).toLocaleDateString("en-IN") %>
                        <% } else { %>
                            Not available
                        <% } %>
                    </p>

                    <p>
                        <strong>Status:</strong>

                        <% const currentStatus =
                            mess &&
                            mess.approval_status
                                ? mess.approval_status
                                : "Pending";
                        %>

                        <% if (
                            currentStatus
                                .toLowerCase()
                                .trim() === "approved"
                        ) { %>

                            <span class="badge bg-success">
                                Approved
                            </span>

                        <% } else { %>

                            <span class="badge bg-warning text-dark">
                                <%= currentStatus %>
                            </span>

                        <% } %>
                    </p>
                </div>
            </div>

        </div>

        <hr>

        <!-- Attendance Form -->

        <h4 class="section-title mt-3">
            Submit Mess Attendance
        </h4>

        <form
            action="/mess/attendance"
            method="POST"
            class="mb-4"
        >

            <div class="mb-3">
                <label
                    for="attendanceDate"
                    class="form-label"
                >
                    Select Date
                </label>

                <input
                    type="date"
                    name="attendance_date"
                    id="attendanceDate"
                    class="form-control"
                    value="<%= new Date()
                        .toISOString()
                        .split('T')[0] %>"
                    required
                >
            </div>

            <div class="row">

                <div class="col-md-4">
                    <div class="meal-option">

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="breakfast"
                                value="1"
                                id="breakfast"
                            >

                            <label
                                class="form-check-label"
                                for="breakfast"
                            >
                                Breakfast Eaten
                            </label>
                        </div>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="meal-option">

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="lunch"
                                value="1"
                                id="lunch"
                            >

                            <label
                                class="form-check-label"
                                for="lunch"
                            >
                                Lunch Eaten
                            </label>
                        </div>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="meal-option">

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="dinner"
                                value="1"
                                id="dinner"
                            >

                            <label
                                class="form-check-label"
                                for="dinner"
                            >
                                Dinner Eaten
                            </label>
                        </div>

                    </div>
                </div>

            </div>

            <button
                type="submit"
                class="btn btn-success w-100 mt-3"
            >
                Submit Attendance to Admin
            </button>

        </form>

        <hr>

        <!-- Attendance History -->

        <div
            class="d-flex justify-content-between align-items-center mt-3 mb-3"
        >
            <h4 class="section-title mb-0">
                My Mess History
            </h4>

            <span class="badge bg-primary">
                Total Records:
                <%= Array.isArray(attendance)
                    ? attendance.length
                    : 0 %>
            </span>
        </div>

        <div class="table-responsive">

            <table
                class="table table-bordered table-hover"
            >
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Breakfast</th>
                        <th>Lunch</th>
                        <th>Dinner</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (
                        Array.isArray(attendance) &&
                        attendance.length > 0
                    ) { %>

                        <% attendance.forEach((a) => { %>

                            <tr>
                                <td>
                                    <% if (
                                        a.attendance_date
                                    ) { %>

                                        <%= new Date(
                                            a.attendance_date
                                        ).toLocaleDateString(
                                            "en-IN"
                                        ) %>

                                    <% } else { %>

                                        Not available

                                    <% } %>
                                </td>

                                <td>
                                    <% if (
                                        a.breakfast == 1 ||
                                        a.breakfast === true ||
                                        a.breakfast === "Yes"
                                    ) { %>

                                        <span class="badge bg-success">
                                            Yes
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            No
                                        </span>

                                    <% } %>
                                </td>

                                <td>
                                    <% if (
                                        a.lunch == 1 ||
                                        a.lunch === true ||
                                        a.lunch === "Yes"
                                    ) { %>

                                        <span class="badge bg-success">
                                            Yes
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            No
                                        </span>

                                    <% } %>
                                </td>

                                <td>
                                    <% if (
                                        a.dinner == 1 ||
                                        a.dinner === true ||
                                        a.dinner === "Yes"
                                    ) { %>

                                        <span class="badge bg-success">
                                            Yes
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            No
                                        </span>

                                    <% } %>
                                </td>
                            </tr>

                        <% }); %>

                    <% } else { %>

                        <tr>
                            <td
                                colspan="4"
                                class="text-center text-muted py-4"
                            >
                                No attendance records found.
                            </td>
                        </tr>

                    <% } %>

                </tbody>
            </table>

        </div>

        <a
            href="/logout"
            class="btn btn-danger w-100 mt-3"
        >
            Logout
        </a>

    </div>
</div>

<script>
    const attendanceDate =
        document.getElementById("attendanceDate");

    if (attendanceDate) {
        const today = new Date()
            .toISOString()
            .split("T")[0];

        attendanceDate.max = today;
    }
</script>

</body>
</html>