<!DOCTYPE html>
<html>

<head>

<title>PG Floor Map</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:#f1f5f9;
}

.room-box{

width:140px;
height:110px;
border-radius:10px;
color:white;
text-align:center;
padding-top:15px;
margin:10px;
font-weight:bold;

}

.available{
background:#22c55e;
}

.full{
background:#ef4444;
}

.floor{
display:flex;
flex-wrap:wrap;
}

</style>
<style>
.room-box:hover{
transform: scale(1.05);
transition: 0.3s;
cursor:pointer;
}
</style>

</head>

<body>

<div class="container mt-4">

<h2>PG Building Floor Map</h2>

<div class="floor">

<% rooms.forEach(room => { %>

<%
const occupied = room.occupied || 0
const availableBeds = room.capacity - occupied
const status = availableBeds > 0 ? "available" : "full"
%>

<div class="room-box <%= status %>">

Room <%= room.room_number %>

<br>

Beds: <%= room.capacity %>

<br>

Available: <%= availableBeds %>

</div>

<% }) %>

</div>

</div>

</body>

</html>