<!DOCTYPE html>
<html>

<head>

<title>PG Food Menu</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:#f4f6f9;
font-family:Arial;
padding:20px;
}

.menu-title{
text-align:center;
margin-bottom:30px;
}

.day-card{
background:white;
border-radius:12px;
padding:20px;
margin-bottom:20px;
box-shadow:0px 5px 15px rgba(0,0,0,0.1);
}

.meal{
padding:10px;
margin-top:10px;
border-radius:8px;
color:white;
}

.breakfast{
background:#ff9800;
}

.lunch{
background:#4caf50;
}

.dinner{
background:#2196f3;
}

</style>

</head>

<body>

<h2 class="menu-title">🍽 PG Weekly Food Menu</h2>

<div class="container">

<% menu.forEach(item=>{ %>

<div class="day-card">

<h4 class="text-center"><%= item.day %></h4>

<div class="meal breakfast">

<b>Breakfast</b>

<p><%= item.breakfast %></p>

</div>

<div class="meal lunch">

<b>Lunch</b>

<p><%= item.lunch %></p>

</div>

<div class="meal dinner">

<b>Dinner</b>

<p><%= item.dinner %></p>

</div>

</div>

<% }) %>

</div>

<script>
setInterval(() => {
    fetch('/api/dashboard-data')
    .then(res => res.json())
    .then(data => {
        document.getElementById("income").innerText = data.income;
    });
}, 5000);
</script>

</body>

</html>