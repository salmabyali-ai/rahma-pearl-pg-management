<!DOCTYPE html>
<html>
<head>
<title>PG Student Management</title>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
background:#f4f6f9;
padding:40px;
font-family:Arial;
}

.card{
background:white;
padding:25px;
border-radius:10px;
box-shadow:0 10px 20px rgba(0,0,0,0.1);
}

table{
margin-top:20px;
}

.action-btn{
margin:2px;
}
</style>
</head>

<body>

<div class="container">
<div class="card">

<h3 class="mb-4">Resident Students Management</h3>

<a href="/admin/students/add" class="btn btn-primary mb-3">
+ Add Student
</a>

<table class="table table-bordered table-striped">
<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Phone</th>
<th>Room</th>
<th>Payment</th>
<th>Approval</th>
<th>Action</th>
</tr>
</thead>

<tbody>

<% students.forEach(function(student){ %>

<tr>

<td>
<%= student.first_name %> <%= student.last_name %>
</td>

<td>
<%= student.email %>
</td>

<td>
<%= student.phone || student.mobile || "-" %>
</td>

<td>
<%= student.room_number || "Not Assigned" %>
</td>

<td>
<% if(student.payment_status === "verified"){ %>
<span class="badge bg-success">Verified</span>
<% } else { %>
<span class="badge bg-warning">Pending</span>
<% } %>
</td>

<td>
<% if(student.status === "approved" || student.status === "Approved"){ %>
<span class="badge bg-success">Approved</span>
<% } else { %>
<a href="/admin/students/approve/<%= student.id %>" class="btn btn-success btn-sm">
Approve
</a>
<% } %>
</td>

<td>

<a href="/admin/students/edit/<%= student.id %>" class="btn btn-primary btn-sm action-btn">
Edit
</a>

<a href="/admin/students/reminder/<%= student.id %>"
   class="btn btn-info btn-sm action-btn">
Reminder
</a>

<a href="/admin/students/assign-room/<%= student.id %>" class="btn btn-warning btn-sm action-btn">
Assign Room
</a>

<form action="/admin/students/delete/<%= student.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete student?')">
<button class="btn btn-danger btn-sm action-btn">
Delete
</button>
</form>

</td>

</tr>

<% }) %>

</tbody>
</table>

<br>

<a href="/admin/dashboard" class="btn btn-secondary">
Back to Dashboard
</a>

</div>
</div>

</body>
</html>