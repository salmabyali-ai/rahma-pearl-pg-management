<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login | Rahma Pearl Girls PG</title>


    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Font Awesome -->
    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        rel="stylesheet"
    >


    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >


<style>

/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* =========================================================
   BODY
========================================================= */

body {

    min-height: 100vh;

    font-family: 'Poppins', sans-serif;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 30px 15px;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(255,255,255,0.18),
            transparent 22%
        ),
        radial-gradient(
            circle at 85% 80%,
            rgba(255,255,255,0.15),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #172554,
            #312e81,
            #581c87,
            #6d28d9
        );

    overflow-x: hidden;

}


/* =========================================================
   FLOATING DECORATIONS
========================================================= */

.decor {

    position: fixed;

    border-radius: 50%;

    background: rgba(255,255,255,0.08);

    pointer-events: none;

}


.decor-one {

    width: 280px;
    height: 280px;

    top: -120px;
    left: -100px;

}


.decor-two {

    width: 350px;
    height: 350px;

    bottom: -180px;
    right: -130px;

}


.decor-three {

    width: 90px;
    height: 90px;

    top: 12%;
    right: 12%;

}


.decor-four {

    width: 55px;
    height: 55px;

    bottom: 18%;
    left: 10%;

}


/* =========================================================
   MAIN CARD
========================================================= */

.login-card {

    width: 100%;

    max-width: 1050px;

    min-height: 610px;

    display: flex;

    overflow: hidden;

    border-radius: 30px;

    background: rgba(255,255,255,0.97);

    box-shadow:
        0 35px 90px rgba(0,0,0,0.35);

    animation: cardIn 0.8s ease;

}


@keyframes cardIn {

    from {

        opacity: 0;

        transform:
            translateY(35px)
            scale(0.96);

    }

    to {

        opacity: 1;

        transform:
            translateY(0)
            scale(1);

    }

}


/* =========================================================
   LEFT BRANDING SECTION
========================================================= */

.brand-section {

    width: 52%;

    position: relative;

    overflow: hidden;

    color: white;

    padding: 55px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #1e3a8a,
            #3730a3 42%,
            #6d28d9
        );

}


/* Decorative glow */

.brand-section::before {

    content: "";

    position: absolute;

    width: 400px;

    height: 400px;

    border-radius: 50%;

    top: -200px;

    right: -160px;

    background:
        rgba(255,255,255,0.07);

}


.brand-section::after {

    content: "";

    position: absolute;

    width: 300px;

    height: 300px;

    border-radius: 50%;

    bottom: -180px;

    left: -130px;

    background:
        rgba(255,255,255,0.06);

}


/* =========================================================
   LOGO
========================================================= */

.logo-box {

    position: relative;

    z-index: 2;

    width: 105px;

    height: 105px;

    display: flex;

    justify-content: center;

    align-items: center;

    border-radius: 28px;

    background:
        rgba(255,255,255,0.96);

    padding: 10px;

    margin-bottom: 25px;

    box-shadow:
        0 15px 35px rgba(0,0,0,0.25);

}


.logo-box img {

    width: 100%;

    height: 100%;

    object-fit: contain;

    border-radius: 18px;

}


/* =========================================================
   BRAND NAME
========================================================= */

.brand-small {

    position: relative;

    z-index: 2;

    font-size: 13px;

    letter-spacing: 4px;

    font-weight: 600;

    color: rgba(255,255,255,0.85);

    margin-bottom: 5px;

}


.brand-name {

    position: relative;

    z-index: 2;

    font-family:
        'Playfair Display',
        serif;

    font-size: 49px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: 1px;

    margin-bottom: 5px;

}


.brand-name span {

    display: block;

    color: #f5d58a;

}


.brand-location {

    position: relative;

    z-index: 2;

    font-size: 13px;

    font-weight: 600;

    letter-spacing: 3px;

    margin-top: 8px;

    color: #f3e8ff;

}


/* =========================================================
   TAGLINE
========================================================= */

.tagline {

    position: relative;

    z-index: 2;

    margin-top: 28px;

    padding-left: 17px;

    border-left: 3px solid #f5d58a;

    font-size: 15px;

    line-height: 1.8;

    color: rgba(255,255,255,0.9);

    max-width: 430px;

}


.tagline strong {

    color: #f5d58a;

}


/* =========================================================
   FEATURES
========================================================= */

.features {

    position: relative;

    z-index: 2;

    margin-top: 28px;

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

}


.feature {

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 8px 13px;

    border-radius: 30px;

    background:
        rgba(255,255,255,0.10);

    border:
        1px solid rgba(255,255,255,0.12);

    font-size: 12px;

    color: white;

}


.feature i {

    color: #f5d58a;

}


/* =========================================================
   RIGHT LOGIN SECTION
========================================================= */

.login-section {

    width: 48%;

    padding: 45px 55px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    background: white;

}


/* =========================================================
   BACK BUTTON
========================================================= */

.back-btn {

    width: fit-content;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 8px 16px;

    border-radius: 25px;

    text-decoration: none;

    color: #4f46e5;

    background: #f5f5ff;

    border: 1px solid #e5e7ff;

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 27px;

    transition: all 0.3s ease;

}


.back-btn:hover {

    color: white;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    transform: translateX(-4px);

    box-shadow:
        0 8px 20px rgba(79,70,229,0.25);

}


/* =========================================================
   LOGIN HEADING
========================================================= */

.login-heading {

    font-family:
        'Playfair Display',
        serif;

    font-size: 38px;

    font-weight: 800;

    color: #20213a;

    margin-bottom: 4px;

}


.login-heading span {

    color: #6d28d9;

}


.login-subtitle {

    color: #85889a;

    font-size: 13px;

    margin-bottom: 28px;

}


/* =========================================================
   FORM LABEL
========================================================= */

.form-label {

    font-size: 13px;

    font-weight: 600;

    color: #34364b;

    margin-bottom: 7px;

}


/* =========================================================
   INPUT
========================================================= */

.input-wrapper {

    position: relative;

    margin-bottom: 19px;

}


.input-icon {

    position: absolute;

    left: 16px;

    top: 50%;

    transform: translateY(-50%);

    color: #6366f1;

    z-index: 5;

    font-size: 14px;

}


.form-control {

    height: 52px;

    border-radius: 13px;

    border: 1.5px solid #e3e5ed;

    background: #fafaff;

    padding-left: 45px;

    padding-right: 45px;

    font-size: 13px;

    transition: all 0.3s ease;

}


.form-control:focus {

    border-color: #6366f1;

    background: white;

    box-shadow:
        0 0 0 4px rgba(99,102,241,0.10);

}


.form-control::placeholder {

    color: #a3a5b2;

}


/* =========================================================
   PASSWORD BUTTON
========================================================= */

.password-toggle {

    position: absolute;

    right: 14px;

    top: 50%;

    transform: translateY(-50%);

    border: none;

    background: transparent;

    color: #9a9cac;

    cursor: pointer;

    z-index: 5;

}


.password-toggle:hover {

    color: #6366f1;

}


/* =========================================================
   LINKS
========================================================= */

.links {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin: 3px 0 24px;

}


.links a {

    text-decoration: none;

    font-size: 12px;

    font-weight: 600;

    color: #6366f1;

    transition: 0.2s;

}


.links a:hover {

    color: #7c3aed;

}


/* =========================================================
   LOGIN BUTTON
========================================================= */

.login-btn {

    width: 100%;

    height: 53px;

    border: none;

    border-radius: 14px;

    color: white;

    font-size: 14px;

    font-weight: 700;

    letter-spacing: .2px;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    box-shadow:
        0 12px 25px rgba(99,102,241,0.28);

    transition: all 0.3s ease;

}


.login-btn:hover {

    transform: translateY(-2px);

    box-shadow:
        0 16px 30px rgba(99,102,241,0.35);

}


.login-btn i {

    margin-right: 7px;

}


/* =========================================================
   SECURITY
========================================================= */

.security {

    text-align: center;

    margin-top: 20px;

    font-size: 10px;

    color: #999cab;

}


.security i {

    color: #6366f1;

    margin-right: 4px;

}


/* =========================================================
   FOOTER BRAND
========================================================= */

.footer-brand {

    text-align: center;

    margin-top: 15px;

    font-size: 10px;

    color: #b0b2bd;

    letter-spacing: 1px;

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width: 850px) {

    body {

        padding: 15px;

    }


    .login-card {

        max-width: 550px;

        min-height: auto;

    }


    .brand-section {

        display: none;

    }


    .login-section {

        width: 100%;

        padding: 35px 30px;

    }

}


@media(max-width: 480px) {

    .login-card {

        border-radius: 22px;

    }


    .login-section {

        padding: 28px 20px;

    }


    .login-heading {

        font-size: 32px;

    }


    .links a {

        font-size: 11px;

    }

}

</style>

</head>


<body>


<!-- =========================================================
     BACKGROUND DECORATIONS
========================================================= -->

<div class="decor decor-one"></div>

<div class="decor decor-two"></div>

<div class="decor decor-three"></div>

<div class="decor decor-four"></div>



<!-- =========================================================
     MAIN LOGIN CARD
========================================================= -->

<div class="login-card">


    <!-- =====================================================
         BRAND SECTION
    ====================================================== -->

    <div class="brand-section">


        <!-- LOGO -->

        <div class="logo-box">

            <img
                src="/images/pg-logo.png"
                alt="Rahma Pearl Girls PG Logo"
            >

        </div>


        <!-- SMALL BRAND -->

        <div class="brand-small">

            WELCOME TO

        </div>


        <!-- MAIN PG NAME -->

        <div class="brand-name">

            RAHMA

            <span>PEARL</span>

        </div>


        <!-- LOCATION -->

        <div class="brand-location">

            GIRLS PG • HUBLI

        </div>


        <!-- TAGLINE -->

        <div class="tagline">

            <strong>A Home of Peace, Protection & Blessings.</strong>

            <br>

            A comfortable and secure place designed
            to make every stay feel like home.

        </div>


        <!-- FEATURES -->

        <div class="features">


            <div class="feature">

                <i class="fas fa-wifi"></i>

                Free WiFi

            </div>


            <div class="feature">

                <i class="fas fa-shield-heart"></i>

                Safe & Secure

            </div>


            <div class="feature">

                <i class="fas fa-house"></i>

                Comfortable Stay

            </div>


            <div class="feature">

                <i class="fas fa-users"></i>

                Student Friendly

            </div>


        </div>


    </div>



    <!-- =====================================================
         LOGIN SECTION
    ====================================================== -->

    <div class="login-section">


        <!-- BACK -->

        <a
            href="/"
            class="back-btn"
        >

            <i class="fas fa-arrow-left"></i>

            Back to Home

        </a>


        <!-- TITLE -->

        <h1 class="login-heading">

            Welcome <span>Back!</span>

        </h1>


        <p class="login-subtitle">

            Login to your Rahma Pearl PG account

        </p>



        <!-- =================================================
             LOGIN FORM
        ================================================== -->

        <form
            action="/login"
            method="POST"
        >


            <!-- EMAIL -->

            <label class="form-label">

                Email Address

            </label>


            <div class="input-wrapper">

                <i class="fas fa-envelope input-icon"></i>


                <input
                    type="email"
                    name="email"
                    class="form-control"
                    placeholder="Enter your email address"
                    autocomplete="email"
                    required
                >

            </div>



            <!-- PASSWORD -->

            <label class="form-label">

                Password

            </label>


            <div class="input-wrapper">

                <i class="fas fa-lock input-icon"></i>


                <input
                    type="password"
                    name="password"
                    id="password"
                    class="form-control"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required
                >


                <button
                    type="button"
                    class="password-toggle"
                    id="togglePassword"
                    aria-label="Show password"
                >

                    <i class="fas fa-eye"></i>

                </button>

            </div>



            <!-- LINKS -->

            <div class="links">


                <a href="/forgotpassword">

                    <i class="fas fa-key"></i>

                    Forgot Password?

                </a>


                <a href="/register">

                    Create Account

                    <i class="fas fa-arrow-right"></i>

                </a>


            </div>



            <!-- LOGIN -->

            <button
                type="submit"
                class="login-btn"
            >

                <i class="fas fa-right-to-bracket"></i>

                Login to Rahma Pearl

            </button>


        </form>


        <!-- SECURITY -->

        <div class="security">

            <i class="fas fa-shield-halved"></i>

            Your account information is securely protected.

        </div>


        <!-- FOOTER -->

        <div class="footer-brand">

            © RAHMA PEARL GIRLS PG • DHARWAD 

        </div>


    </div>

</div>



<!-- =========================================================
     PASSWORD SHOW / HIDE
========================================================= -->

<script>

const password =
    document.getElementById("password");

const toggle =
    document.getElementById("togglePassword");


toggle.addEventListener("click", function () {

    const icon =
        this.querySelector("i");


    if (password.type === "password") {

        password.type = "text";

        icon.classList.remove("fa-eye");

        icon.classList.add("fa-eye-slash");

        this.setAttribute(
            "aria-label",
            "Hide password"
        );

    }

    else {

        password.type = "password";

        icon.classList.remove("fa-eye-slash");

        icon.classList.add("fa-eye");

        this.setAttribute(
            "aria-label",
            "Show password"
        );

    }

});

</script>


</body>

</html>