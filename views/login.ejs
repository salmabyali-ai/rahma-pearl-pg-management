<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login | Rahma Pearl PG</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:linear-gradient(135deg,#667eea,#764ba2);
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.login-card{
    width:900px;
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 20px 40px rgba(0,0,0,.3);
}

.left{
    background:linear-gradient(135deg,#667eea,#764ba2);
    color:white;
    padding:50px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.left h2{
    font-weight:bold;
}

.right{
    padding:45px;
}

.input-group-text{
    background:#667eea;
    color:white;
    border:none;
}

.form-control{
    height:48px;
}

.btn-login{
    background:#667eea;
    color:white;
    border:none;
    height:48px;
    border-radius:30px;
    font-weight:bold;
}

.btn-login:hover{
    background:#5b6ee1;
    color:white;
}

.links a{
    text-decoration:none;
}

@media(max-width:768px){

.left{
display:none;
}

}
</style>

</head>
<body>

<div class="container">

<div class="row justify-content-center">

<div class="col-lg-10">

<div class="row login-card">

<div class="col-md-6 left">

<h2>Welcome Back 👋</h2>

<p class="mt-3">
Login to manage your
<br>
<b>Rahma Pearl PG Management System</b>
</p>

</div>

<div class="col-md-6 right">

<h3 class="text-center text-primary mb-4">
Login
</h3>

<form action="/login" method="POST">

<div class="mb-3">

<label>Email</label>

<div class="input-group">

<span class="input-group-text">
<i class="fas fa-envelope"></i>
</span>

<input
type="email"
name="email"
class="form-control"
placeholder="Enter Email"
required>

</div>

</div>

<div class="mb-3">

<label>Password</label>

<div class="input-group">

<span class="input-group-text">
<i class="fas fa-lock"></i>
</span>

<input
type="password"
name="password"
class="form-control"
placeholder="Enter Password"
required>

</div>

</div>

<div class="d-flex justify-content-between mb-4 links">

<a href="/forgotpassword">
Forgot Password?
</a>

<a href="/register">
Create Account
</a>

</div>

<button class="btn btn-login w-100" type="submit">
<i class="fas fa-sign-in-alt"></i>
 Login Now
</button>

</form>

</div>

</div>

</div>

</div>

</div>

</body>
</html>