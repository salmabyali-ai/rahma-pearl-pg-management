<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">
<title>PG Profit Report</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
background:#f4f6f9;
font-family:Arial;
}

.card-box{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

</style>

</head>

<body>

<div class="container mt-4">

<h2 class="mb-4">PG Profit Report</h2>

<div class="card-box">

<canvas id="profitChart"></canvas>

</div>

<br>

<div class="row text-center">

<div class="col-md-4">

<div class="card p-3">

<h5>Total Income</h5>

<h3 class="text-success">₹ <%= income %></h3>

</div>

</div>

<div class="col-md-4">

<div class="card p-3">

<h5>Total Expense</h5>

<h3 class="text-danger">₹ <%= expense %></h3>

</div>

</div>

<div class="col-md-4">

<div class="card p-3">

<h5>Profit</h5>

<h3 class="text-primary">

₹ <%= income - expense %>

</h3>

</div>

</div>

</div>

<br>

<a href="/admin/dashboard" class="btn btn-secondary">

Back to Dashboard

</a>

</div>

<script>

const profit = income - expense;

new Chart(ctx,{

type:"doughnut",

data:{

labels:["Income","Expense","Profit"],

datasets:[{

data:[income,expense,profit],

backgroundColor:[
"#22c55e",
"#ef4444",
"#3b82f6"
]

}]

},

options:{
responsive:true,
plugins:{
legend:{
position:"bottom"
}
},
animation:{
duration:2000
}
}

})
</script>
<script>
setInterval(() => {
    location.reload();
}, 10000);
</script>

</body>

</html>