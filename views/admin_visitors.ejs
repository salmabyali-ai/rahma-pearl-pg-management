<!DOCTYPE html>
<html>

<head>
    <title>Visitor Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background:#f5f5f5;
        }

        .container{
            margin-top:40px;
        }

        .card{
            border-radius:10px;
            box-shadow:0 3px 10px rgba(0,0,0,.1);
        }

        table{
            background:#fff;
        }
    </style>

</head>

<body>

<div class="container">

    <h2 class="mb-4 text-primary">
        Visitor Management
    </h2>

    <!-- ADD VISITOR -->

    <div class="card p-4 mb-4">

        <form action="/admin/visitors/add" method="POST">

            <div class="row">

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Visitor Name
                    </label>

                    <input
                        type="text"
                        name="visitor_name"
                        class="form-control"
                        required>

                </div>

                <div class="col-md-2 mb-3">

                    <label class="form-label">
                        Phone
                    </label>

                    <input
                        type="text"
                        name="phone"
                        class="form-control"
                        required>

                </div>

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Student Name
                    </label>

                    <input
                        type="text"
                        name="student_name"
                        class="form-control"
                        required>

                </div>

                <div class="col-md-2 mb-3">

                    <label class="form-label">
                        Room No
                    </label>

                    <input
                        type="text"
                        name="room_number"
                        class="form-control"
                        required>

                </div>
                <input type="datetime-local" name="entry_time" class="form-control">
                <input type="datetime-local" name="exit_time" class="form-control">

                <div class="col-md-2 mb-3 d-grid">

                    <label>&nbsp;</label>

                    <button
                        class="btn btn-primary">

                        Add Visitor

                    </button>

                </div>

            </div>

        </form>

    </div>

    <!-- VISITOR TABLE -->

    <div class="card p-3">

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

                <tr>

                    <th>ID</th>
                    <th>Visitor</th>
                    <th>Phone</th>
                    <th>Student</th>
                    <th>Room</th>
                    <th>Entry Time</th>
                    <th>Exit Time</th>
                    <th>Action</th>

                </tr>

            </thead>

              <tbody>

<% if (visitors && visitors.length > 0) { %>

    <% visitors.forEach(function(v) { %>

    <tr>

        <td><%= v.id %></td>

        <td><%= v.visitor_name %></td>

        <td><%= v.phone %></td>

        <td><%= v.student_name %></td>

        <td><%= v.room_number %></td>

        <td>
            <%= v.entry_time ? new Date(v.entry_time).toLocaleString("en-IN") : "-" %>
        </td>

        <td>
            <%= v.exit_time ? new Date(v.exit_time).toLocaleString("en-IN") : "Still Inside" %>
        </td>

        <td>

            <a href="/admin/visitors/edit/<%= v.id %>"
               class="btn btn-primary btn-sm">
                Edit
            </a>

            <form action="/admin/visitors/delete/<%= v.id %>"
                  method="POST"
                  style="display:inline;">

                <button class="btn btn-danger btn-sm"
                        onclick="return confirm('Delete this visitor?')">
                    Delete
                </button>

            </form>

            <% if(v.exit_time){ %>

                <span class="badge bg-success">
                    Approved
                </span>

            <% } else { %>

                <a href="/admin/visitors/approve/<%= v.id %>"
                   class="btn btn-success btn-sm">
                    Approve Exit
                </a>

            <% } %>

        </td>

    </tr>

    <% }) %>

<% } else { %>

<tr>

    <td colspan="8" class="text-center">
        No Visitors Found
    </td>

</tr>

<% } %>

</tbody>

        </table>

    </div>

    <br>

    <a href="/admin/dashboard" class="btn btn-secondary">

        ← Back to Dashboard

    </a>

</div>

</body>
</html>