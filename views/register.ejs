<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Registration | Rahma Pearl Girls PG</title>

    <link rel="icon" type="image/png" href="/images/pg-logo.png">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #5b54a4, #7565c7);
            min-height: 100vh;
        }

        .topbar {
            background: #fff;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 7%;
        }

        .brand {
            color: #6575e8;
            font-size: 24px;
            font-weight: 800;
        }

        .brand i {
            margin-right: 10px;
        }

        .login-btn {
            border: 2px solid #6376ec;
            color: #6376ec;
            background: white;
            border-radius: 30px;
            padding: 10px 25px;
            font-weight: 700;
            text-decoration: none;
        }

        .login-btn:hover {
            background: #6376ec;
            color: white;
        }

        .main-container {
            width: 88%;
            max-width: 1150px;
            margin: 55px auto;
            background: white;
            border-radius: 25px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 42% 58%;
            box-shadow: 0 20px 60px rgba(0,0,0,.20);
        }

        .left-section {
            background: linear-gradient(160deg, #6878e7, #7061c5);
            color: white;
            padding: 45px 35px;
        }

        .left-section h1 {
            font-size: 34px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .left-section > p {
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .feature {
            border: 1px solid rgba(255,255,255,.25);
            background: rgba(255,255,255,.12);
            border-radius: 17px;
            padding: 18px;
            margin-bottom: 15px;
            display: flex;
            gap: 15px;
        }

        .feature-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
            border-radius: 12px;
            background: white;
            color: #6375e6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .feature h4 {
            margin: 0 0 5px;
            font-size: 16px;
            font-weight: 800;
        }

        .feature p {
            margin: 0;
            font-size: 13px;
            line-height: 1.5;
        }

        .right-section {
            padding: 45px 40px;
        }

        .title {
            text-align: center;
            color: #6575e8;
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .section-title {
            color: #6375e7;
            font-size: 16px;
            font-weight: 800;
            border-bottom: 1px solid #ddd;
            padding-bottom: 8px;
            margin-top: 25px;
            margin-bottom: 18px;
        }

        .section-title i {
            margin-right: 8px;
        }

        .registration-types {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }

        .type-card {
            border: 2px solid #ddd;
            border-radius: 18px;
            padding: 22px 15px;
            text-align: center;
            cursor: pointer;
            transition: .2s;
        }

        .type-card:hover {
            border-color: #6878e7;
            transform: translateY(-2px);
        }

        .type-card.active {
            border-color: #6375ec;
            background: #f3f4ff;
            box-shadow: 0 8px 20px rgba(99,117,236,.12);
        }

        .type-card i {
            color: #6575e8;
            font-size: 30px;
            margin-bottom: 10px;
        }

        .type-card h4 {
            font-size: 16px;
            margin: 0 0 6px;
            font-weight: 800;
        }

        .type-card p {
            margin: 0;
            color: #777;
            font-size: 13px;
        }

        .form-label {
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .required {
            color: red;
        }

        .form-control,
        .form-select {
            min-height: 50px;
            border-radius: 12px;
            border: 1px solid #d8d8e5;
            padding: 12px 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #6575e8;
            box-shadow: 0 0 0 3px rgba(101,117,232,.12);
        }

        textarea.form-control {
            min-height: 110px;
        }

        .alert {
            border-radius: 15px;
        }

        /* MESS SECTION */
        #messSection {
            display: none;
            background: #f7f7ff;
            border: 2px solid #e0e2ff;
            border-radius: 18px;
            padding: 22px;
            margin-top: 20px;
        }

        #messSection.show {
            display: block;
        }

        .mess-title {
            color: #6575e8;
            font-weight: 800;
            font-size: 19px;
            margin-bottom: 15px;
        }

        .price-box {
            background: linear-gradient(135deg, #6878e7, #7565c7);
            color: white;
            border-radius: 15px;
            padding: 15px;
            margin-top: 15px;
            text-align: center;
        }

        .price-box .amount {
            font-size: 30px;
            font-weight: 800;
        }

        .price-box small {
            opacity: .9;
        }

        .terms {
            background: #f7f7ff;
            border-radius: 12px;
            padding: 15px;
            margin-top: 20px;
        }

        .terms label {
            font-size: 14px;
            color: #555;
        }

        .submit-btn {
            width: 100%;
            border: none;
            background: linear-gradient(135deg, #6275ea, #725fc3);
            color: white;
            padding: 15px;
            border-radius: 13px;
            font-size: 17px;
            font-weight: 800;
            margin-top: 25px;
        }

        .submit-btn:hover {
            opacity: .92;
        }

        .hidden {
            display: none !important;
        }

        .info-box {
            background: #fff8df;
            border: 1px solid #f0df9a;
            color: #725c1c;
            border-radius: 12px;
            padding: 12px 15px;
            margin-top: 15px;
            font-size: 14px;
        }

        @media(max-width: 900px) {
            .main-container {
                grid-template-columns: 1fr;
                width: 95%;
            }

            .left-section {
                display: none;
            }

            .right-section {
                padding: 30px 20px;
            }
        }

        @media(max-width: 600px) {
            .registration-types {
                grid-template-columns: 1fr;
            }

            .topbar {
                padding: 0 20px;
            }

            .brand {
                font-size: 18px;
            }

            .main-container {
                margin: 20px auto;
            }
        }
    </style>
</head>

<body>

<!-- ============================= -->
<!-- TOP BAR -->
<!-- ============================= -->

<div class="topbar">

    <div class="brand">
        <i class="fa-solid fa-house-chimney"></i>
        Rahma Pearl Girls PG
    </div>

    <a href="/login" class="login-btn">
        <i class="fa-solid fa-right-to-bracket"></i>
        Login
    </a>

</div>


<!-- ============================= -->
<!-- MAIN -->
<!-- ============================= -->

<div class="main-container">

    <!-- ============================= -->
    <!-- LEFT SIDE -->
    <!-- ============================= -->

    <div class="left-section">

        <h1>
            Welcome to Rahma Pearl Girls PG
        </h1>

        <p>
            Apply for PG accommodation or mess facilities
            using one simple registration form.
        </p>


        <div class="feature">

            <div class="feature-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
                <h4>Safe Environment</h4>

                <p>
                    Secure and student-friendly accommodation
                    with responsible management.
                </p>
            </div>

        </div>


        <div class="feature">

            <div class="feature-icon">
                <i class="fa-solid fa-bed"></i>
            </div>

            <div>
                <h4>Comfortable Rooms</h4>

                <p>
                    Clean rooms with practical sharing options
                    and essential facilities.
                </p>
            </div>

        </div>


        <div class="feature">

            <div class="feature-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <div>
                <h4>Healthy Meals</h4>

                <p>
                    Breakfast, lunch and dinner according to
                    the selected mess plan.
                </p>
            </div>

        </div>


        <div class="feature">

            <div class="feature-icon">
                <i class="fa-solid fa-wifi"></i>
            </div>

            <div>
                <h4>Essential Facilities</h4>

                <p>
                    Wi-Fi, water, electricity and properly
                    maintained common areas.
                </p>
            </div>

        </div>


        <div class="feature">

            <div class="feature-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div>
                <h4>Online Dashboard</h4>

                <p>
                    View attendance, payments, complaints
                    and meal details online.
                </p>
            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- RIGHT SIDE -->
    <!-- ============================= -->

    <div class="right-section">

        <h2 class="title">
            <i class="fa-solid fa-user-plus"></i>
            Create Account
        </h2>

        <p class="subtitle">
            Select PG Student or Mess Student and complete your details.
        </p>


        <!-- ERROR -->
        <% if (typeof error !== "undefined" && error) { %>

            <div class="alert alert-danger">

                <i class="fa-solid fa-circle-exclamation"></i>

                <strong>Registration failed:</strong>

                <%= error %>

            </div>

        <% } %>


        <!-- SUCCESS -->
        <% if (typeof success !== "undefined" && success) { %>

            <div class="alert alert-success">

                <i class="fa-solid fa-circle-check"></i>

                <%= success %>

            </div>

        <% } %>


        <!-- ============================= -->
        <!-- FORM -->
        <!-- ============================= -->

        <form
            action="/register"
            method="POST"
            enctype="multipart/form-data"
            id="registrationForm"
        >


            <!-- ============================= -->
            <!-- REGISTRATION TYPE -->
            <!-- ============================= -->

            <div class="section-title">
                <i class="fa-solid fa-users"></i>
                Select Registration Type
            </div>


            <div class="registration-types">


                <!-- PG -->
                <div
                    class="type-card active"
                    id="pgCard"
                    onclick="selectRegistrationType('student')"
                >

                    <i class="fa-solid fa-user-graduate"></i>

                    <h4>
                        PG Student
                    </h4>

                    <p>
                        Room and food facilities
                    </p>

                </div>


                <!-- MESS -->
                <div
                    class="type-card"
                    id="messCard"
                    onclick="selectRegistrationType('mess')"
                >

                    <i class="fa-solid fa-bowl-food"></i>

                    <h4>
                        Mess Student
                    </h4>

                    <p>
                        Food facility only
                    </p>

                </div>

            </div>


            <!-- IMPORTANT -->
            <input
                type="hidden"
                name="role"
                id="role"
                value="<%= (formData && formData.role) ? formData.role : 'student' %>"
            >


            <!-- ============================= -->
            <!-- PERSONAL INFORMATION -->
            <!-- ============================= -->

            <div class="section-title">

                <i class="fa-solid fa-address-card"></i>

                Personal Information

            </div>


            <div class="row g-3">


                <!-- FIRST NAME -->

                <div class="col-md-6">

                    <label class="form-label">
                        First Name
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        name="first_name"
                        class="form-control"
                        placeholder="Enter first name"
                        value="<%= formData && formData.first_name ? formData.first_name : '' %>"
                        required
                    >

                </div>


                <!-- LAST NAME -->

                <div class="col-md-6">

                    <label class="form-label">
                        Last Name
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        name="last_name"
                        class="form-control"
                        placeholder="Enter last name"
                        value="<%= formData && formData.last_name ? formData.last_name : '' %>"
                        required
                    >

                </div>


                <!-- EMAIL -->

                <div class="col-md-6">

                    <label class="form-label">
                        Email Address
                        <span class="required">*</span>
                    </label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="example@gmail.com"
                        value="<%= formData && formData.email ? formData.email : '' %>"
                        required
                    >

                </div>


                <!-- PHONE -->

                <div class="col-md-6">

                    <label class="form-label">
                        Phone Number
                        <span class="required">*</span>
                    </label>

                    <input
                        type="tel"
                        name="phone"
                        class="form-control"
                        placeholder="10-digit phone number"
                        maxlength="10"
                        value="<%= formData && formData.phone ? formData.phone : '' %>"
                        required
                    >

                </div>


                <!-- ADDRESS -->

                <div class="col-12">

                    <label class="form-label">
                        Full Address
                        <span class="required">*</span>
                    </label>

                    <textarea
                        name="address"
                        class="form-control"
                        placeholder="Enter house number, area, city, state and PIN code"
                        required
                    ><%= formData && formData.address ? formData.address : '' %></textarea>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MESS SECTION -->
            <!-- ================================================= -->

            <div id="messSection">

                <div class="mess-title">

                    <i class="fa-solid fa-utensils"></i>

                    Mess Registration Details

                </div>


                <div class="info-box">

                    <i class="fa-solid fa-circle-info"></i>

                    Mess Student registration provides food services
                    without room accommodation.

                </div>


                <div class="row g-3 mt-1">


                    <!-- START DATE -->

                    <div class="col-md-6">

                        <label class="form-label">

                            Mess Starting Date

                            <span class="required">*</span>

                        </label>

                        <input
                            type="date"
                            name="from_date"
                            id="from_date"
                            class="form-control"
                            value="<%= formData && formData.from_date ? formData.from_date : '' %>"
                        >

                    </div>


                    <!-- END DATE -->

                    <div class="col-md-6">

                        <label class="form-label">

                            Mess Ending Date

                            <span class="required">*</span>

                        </label>

                        <input
                            type="date"
                            name="to_date"
                            id="to_date"
                            class="form-control"
                            value="<%= formData && formData.to_date ? formData.to_date : '' %>"
                        >

                    </div>


                    <!-- MEAL TYPE -->

                    <div class="col-md-12">

                        <label class="form-label">

                            Meal Type

                            <span class="required">*</span>

                        </label>

                        <select
                            name="meal_type"
                            id="meal_type"
                            class="form-select"
                        >

                            <option value="Full Day">
                                Full Day = 3000
                            </option>

                            <option value="Breakfast">
                                Breakfast = 1000
                            </option>

                            <option value="Lunch">
                                Lunch = 1000
                            </option>

                            <option value="Dinner">
                                Dinner = 1000
                            </option>

                            <option value="Lunch and Dinner">
                                Lunch and Dinner = 2000
                            </option>

                        </select>

                    </div>

                </div>


                <!-- ============================= -->
                <!-- MESS PRICE -->
                <!-- ============================= -->

                <div class="price-box">

                    <small>
                        Monthly Mess Fee
                    </small>

                    <div class="amount">
                        ₹3,000
                    </div>

                    <small>
                        Food facility only
                    </small>

                </div>

            </div>


            <!-- ============================= -->
            <!-- ACCOUNT SECURITY -->
            <!-- ============================= -->

            <div class="section-title">

                <i class="fa-solid fa-lock"></i>

                Account Security

            </div>


            <div class="row g-3">


                <!-- PASSWORD -->

                <div class="col-md-6">

                    <label class="form-label">

                        Password

                        <span class="required">*</span>

                    </label>

                    <div class="input-group">

                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control"
                            placeholder="Minimum 6 characters"
                            minlength="6"
                            required
                        >

                        <button
                            type="button"
                            class="btn btn-outline-secondary"
                            onclick="togglePassword('password', this)"
                        >
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </div>

                    <small class="text-muted">
                        Use letters, numbers and symbols.
                    </small>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="col-md-6">

                    <label class="form-label">

                        Confirm Password

                        <span class="required">*</span>

                    </label>

                    <div class="input-group">

                        <input
                            type="password"
                            name="confirm_password"
                            id="confirm_password"
                            class="form-control"
                            placeholder="Confirm your password"
                            minlength="6"
                            required
                        >

                        <button
                            type="button"
                            class="btn btn-outline-secondary"
                            onclick="togglePassword('confirm_password', this)"
                        >
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </div>

                </div>

            </div>


            <!-- ============================= -->
            <!-- PAYMENT PROOF - PG ONLY -->
            <!-- ============================= -->

            <div id="paymentSection">

                <div class="section-title">

                    <i class="fa-solid fa-receipt"></i>

                    Payment Proof

                </div>

                <div class="info-box">

                    <i class="fa-solid fa-circle-info"></i>

                    PG students can upload their payment screenshot.
                    Admin will verify the payment before approval.

                </div>

                <div class="mt-3">

                    <label class="form-label">

                        Payment Screenshot

                    </label>

                    <input
                        type="file"
                        name="payment_proof"
                        class="form-control"
                        accept="image/*,.pdf"
                    >

                </div>

            </div>


            <!-- ============================= -->
            <!-- TERMS -->
            <!-- ============================= -->

            <div class="section-title">

                <i class="fa-solid fa-scale-balanced"></i>

                Terms and Conditions

            </div>


            <div class="terms">

                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="accept_terms"
                        value="yes"
                        id="accept_terms"
                        required
                    >

                    <label
                        class="form-check-label"
                        for="accept_terms"
                    >

                        I confirm that the information provided
                        is correct and I agree to the PG/Mess
                        terms and conditions.

                    </label>

                </div>

            </div>


            <!-- ============================= -->
            <!-- SUBMIT -->
            <!-- ============================= -->

            <button
                type="submit"
                class="submit-btn"
                id="submitBtn"
            >

                <i class="fa-solid fa-user-plus"></i>

                Create Account

            </button>


        </form>

    </div>

</div>


<!-- ============================= -->
<!-- JAVASCRIPT -->
<!-- ============================= -->

<script>

    function selectRegistrationType(type) {

        const roleInput =
            document.getElementById("role");

        const pgCard =
            document.getElementById("pgCard");

        const messCard =
            document.getElementById("messCard");

        const messSection =
            document.getElementById("messSection");

        const paymentSection =
            document.getElementById("paymentSection");

        const fromDate =
            document.getElementById("from_date");

        const toDate =
            document.getElementById("to_date");


        roleInput.value = type;


        if (type === "mess") {

            /* ---------------------------- */
            /* MESS SELECTED */
            /* ---------------------------- */

            messCard.classList.add("active");

            pgCard.classList.remove("active");

            messSection.classList.add("show");

            paymentSection.classList.add("hidden");


            /*
             * IMPORTANT:
             * Make dates REQUIRED only for mess.
             */

            fromDate.required = true;

            toDate.required = true;

        }

        else {

            /* ---------------------------- */
            /* PG SELECTED */
            /* ---------------------------- */

            pgCard.classList.add("active");

            messCard.classList.remove("active");

            messSection.classList.remove("show");

            paymentSection.classList.remove("hidden");


            /*
             * Dates are not required for PG.
             */

            fromDate.required = false;

            toDate.required = false;

        }

    }


    function togglePassword(id, button) {

        const input =
            document.getElementById(id);

        const icon =
            button.querySelector("i");


        if (input.type === "password") {

            input.type = "text";

            icon.classList.remove("fa-eye");

            icon.classList.add("fa-eye-slash");

        }

        else {

            input.type = "password";

            icon.classList.remove("fa-eye-slash");

            icon.classList.add("fa-eye");

        }

    }


    /* ============================= */
    /* PASSWORD CHECK */
    /* ============================= */

    document
        .getElementById("registrationForm")
        .addEventListener("submit", function(event) {

            const password =
                document.getElementById("password").value;

            const confirmPassword =
                document.getElementById("confirm_password").value;

            const role =
                document.getElementById("role").value;

            const fromDate =
                document.getElementById("from_date").value;

            const toDate =
                document.getElementById("to_date").value;


            /* Password */

            if (password !== confirmPassword) {

                event.preventDefault();

                alert(
                    "Password and confirm password do not match."
                );

                return;

            }


            /* Mess dates */

            if (role === "mess") {

                if (!fromDate || !toDate) {

                    event.preventDefault();

                    alert(
                        "Please select Mess Starting Date and Mess Ending Date."
                    );

                    return;

                }


                if (toDate < fromDate) {

                    event.preventDefault();

                    alert(
                        "Mess ending date cannot be earlier than starting date."
                    );

                    return;

                }

            }

        });


    /* ============================= */
    /* RESTORE SELECTED TYPE */
    /* ============================= */

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const role =
                document.getElementById("role").value;


            if (role === "mess") {

                selectRegistrationType("mess");

            }

            else {

                selectRegistrationType("student");

            }

        }
    );

</script>


</body>
</html>