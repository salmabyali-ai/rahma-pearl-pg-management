<!DOCTYPE html>
<html>
<head>
    <title>Admin Expenses</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="padding:40px">

    <h3>Expenses</h3>

    <form action="/admin/expenses/add" method="POST" class="card p-3 mb-4">
        <input type="text" name="description" class="form-control mb-2" placeholder="Description" required>

        <input type="number" name="amount" class="form-control mb-2" placeholder="Amount" required>

        <input type="text" name="category" class="form-control mb-2" placeholder="Category">

        <button class="btn btn-primary">Add Expense</button>
    </form>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Description</th>
                <th>Amount</th>
                <th>Category</th>
                <th>Date</th>
            </tr>
        </thead>

        <tbody>
            <% if (expenses && expenses.length > 0) { %>
                <% expenses.forEach(e => { %>
                    <tr>
                        <td><%= e.description %></td>
                        <td>₹<%= e.amount %></td>
                        <td><%= e.category || "-" %></td>
                        <td><%= e.created_at ? new Date(e.created_at).toLocaleDateString('en-IN') : "-" %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="text-center">No expenses found</td>
                </tr>
            <% } %>
        </tbody>
    </table>

</body>
</html>