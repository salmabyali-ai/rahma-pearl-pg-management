<!DOCTYPE html>
<html>

<head>
<title>Complaint Management</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="padding:40px">

<h3>Student Complaints</h3>

<table class="table table-bordered">

<tr>
<th>Student</th>
<th>Room</th>
<th>Complaint</th>
<th>Status</th>
<th>Update</th>
</tr>

<% complaints.forEach(c => { %>

<tr>

<td><%= c.first_name %> <%= c.last_name %></td>

<td><%= c.room_number %></td>

<td><%= c.description %></td>

<td>
<span class="badge bg-<%= c.status === 'Resolved' ? 'success' : c.status === 'In Progress' ? 'warning' : 'secondary' %>">
<%= c.status %>
</span>
</td>

<td>

    <a href="/admin/complaint-status/<%= c.id %>/In Progress"
       class="btn btn-warning btn-sm">
        In Progress
    </a>

    <a href="/admin/complaint-status/<%= c.id %>/Resolved"
       class="btn btn-success btn-sm">
        Resolved
    </a>

    <form action="/admin/complaints/delete/<%= c.id %>" method="POST" style="display:inline;">
        <button
            class="btn btn-danger btn-sm"
            onclick="return confirm('Delete this complaint?')">
            Delete
        </button>
    </form>

</td>

</tr>

<% }) %>

</table>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Student Complaints</h2>

        <a href="/admin/dashboard" class="btn btn-secondary">
            ← Back to Dashboard
        </a>

    </div>

</body>

</html>