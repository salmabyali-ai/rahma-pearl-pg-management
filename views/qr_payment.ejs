<!DOCTYPE html>
<html>
<head>

<title>QR Payment</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
display:flex;
align-items:center;
justify-content:center;
height:100vh;
background:#f5f6fa;
font-family:Arial;
}

.card{
padding:30px;
border-radius:15px;
box-shadow:0 10px 25px rgba(0,0,0,0.1);
text-align:center;
width:350px;
background:white;
}

.qr-img{
width:250px;
margin-top:15px;
}

</style>

</head>

<body>

<div class="card">

<h3>Rahma Pearl PG Payment</h3>

<p>Scan QR using PhonePe / GPay / Paytm</p>

<img src="/images/qr-code.png.jpeg" alt="Payment QR Code" class="qr-img">

<hr>

<h5>Upload Payment Screenshot</h5>

<form action="/student/pay" method="POST" enctype="multipart/form-data">

<input 
type="number"
name="amount"
placeholder="Enter Amount"
class="form-control"
required
>

<br>

<input 
type="file"
name="screenshot"
class="form-control"
required
>

<br>

<button class="btn btn-success w-100">
Submit Payment
</button>

</form>

<br>

<a href="/student/dashboard" class="btn btn-primary w-100">
Back
</a>

</div>

</body>
</html>