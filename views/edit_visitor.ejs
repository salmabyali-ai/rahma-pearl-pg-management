<!DOCTYPE html>
<html>
<head>
    <title>Edit Visitor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

<div class="card p-4">

<h2>Edit Visitor</h2>

<form action="/admin/visitors/update/<%= visitor.id %>" method="POST">

<div class="mb-3">
<label>Visitor Name</label>
<input type="text" name="visitor_name" class="form-control" value="<%= visitor.visitor_name %>" required>
</div>

<div class="mb-3">
<label>Phone</label>
<input type="text" name="phone" class="form-control" value="<%= visitor.phone %>" required>
</div>

<div class="mb-3">
<label>Student Name</label>
<input type="text" name="student_name" class="form-control" value="<%= visitor.student_name %>" required>
</div>

<div class="mb-3">
<label>Room Number</label>
<input type="text" name="room_number" class="form-control" value="<%= visitor.room_number %>" required>
</div>

<div class="mb-3">
<label>Entry Time</label>
<input
type="datetime-local"
name="entry_time"
class="form-control"
value="<%= visitor.entry_time ? new Date(visitor.entry_time).toISOString().slice(0,16) : '' %>">
</div>

<div class="mb-3">
<label>Exit Time</label>
<input
type="datetime-local"
name="exit_time"
class="form-control"
value="<%= visitor.exit_time ? new Date(visitor.exit_time).toISOString().slice(0,16) : '' %>">
</div>

<button class="btn btn-success">
Update Visitor
</button>

<a href="/admin/visitors" class="btn btn-secondary">
Back
</a>

</form>

</div>

</body>
</html>