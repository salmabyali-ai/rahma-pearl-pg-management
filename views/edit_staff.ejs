<!DOCTYPE html>
<html>
<head>
<title>Edit Staff</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background:#f4f6f9;padding:40px">

<div class="container">
<div class="card shadow p-4">

<h3 class="mb-4">Edit Staff Member</h3>

<form action="/admin/staff/update/<%= staff.id %>" method="POST">

<input name="name" value="<%= staff.name %>" class="form-control mb-3" placeholder="Name" required>

<input name="phone" value="<%= staff.phone %>" class="form-control mb-3" placeholder="Phone" required>

<input name="role" value="<%= staff.role %>" class="form-control mb-3" placeholder="Role" required>

<input name="salary" type="number" value="<%= staff.salary %>" class="form-control mb-3" placeholder="Salary" required>

<button class="btn btn-success">Update Staff</button>

<a href="/admin/staff" class="btn btn-secondary">Cancel</a>

</form>

</div>
</div>

</body>
</html>