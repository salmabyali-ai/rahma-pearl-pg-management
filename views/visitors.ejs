<!DOCTYPE html>
<html>
<head>
    <title>Visitor Management</title>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body{
            background:#f4f6f9;
            padding:40px;
        }

        .card{
            border-radius:12px;
        }

        table th{
            background:#212529;
            color:white;
        }

        .btn-sm{
            margin:2px;
        }

    </style>

</head>

<body>

<div class="container">

<h2 class="text-primary mb-4">
Visitor Management
</h2>

<div class="card shadow p-4 mb-4">

<form action="/add-visitor" method="POST">

<div class="row">

<div class="col-md-3">

<label>Visitor Name</label>

<input
type="text"
name="name"
class="form-control"
required>

</div>

<div class="col-md-2">

<label>Phone</label>

<input
type="text"
name="phone"
class="form-control"
required>

</div>

<div class="col-md-3">

<label>Student Name</label>

<input
type="text"
name="student"
class="form-control"
required>

</div>

<div class="col-md-2">

<label>Entry Time</label>

<input
type="datetime-local"
name="entry_time"
class="form-control"
required>

</div>

<div class="col-md-2">

<label>Exit Time</label>

<input
type="datetime-local"
name="exit_time"
class="form-control">

</div>

</div>

<br>

<button class="btn btn-primary">
Add Visitor
</button>

</form>

</div>

<div class="card shadow p-3">

<table class="table table-bordered table-hover">

<thead>

<tr>

<th>ID</th>
<th>Visitor</th>
<th>Phone</th>
<th>Student</th>
<th>Entry Time</th>
<th>Exit Time</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% visitors.forEach(v=>{ %>

<tr>

<td><%= v.id %></td>

<td><%= v.name %></td>

<td><%= v.phone %></td>

<td><%= v.student %></td>

<td>

<%= v.entry_time ? new Date(v.entry_time).toLocaleString() : "-" %>

</td>

<td>

<%= v.exit_time ? new Date(v.exit_time).toLocaleString() : "Still Inside" %>

</td>

<td>

<a
href="/admin/visitors/edit/<%= v.id %>"
class="btn btn-primary btn-sm">

Edit

</a>

<form
action="/admin/visitors/delete/<%= v.id %>"
method="POST"
style="display:inline;">

<button
class="btn btn-danger btn-sm"
onclick="return confirm('Delete Visitor?')">

Delete

</button>

</form>

<% if(v.exit_time){ %>

<span class="badge bg-success">

Approved

</span>

<% }else{ %>

<a
href="/admin/visitors/approve/<%= v.id %>"
class="btn btn-success btn-sm">

Approve Exit

</a>

<% } %>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<br>

<a
href="/admin/dashboard"
class="btn btn-secondary">

← Back to Dashboard

</a>

</div>

</body>
</html>