<!DOCTYPE html>
<html>

<head>

<title>Room Occupancy Heatmap</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
background:#f4f6f9;
font-family:Arial;
padding:40px;
}

.chart-card{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

</style>

</head>

<body class="container">

<h2 class="mb-4">Room Occupancy Heatmap</h2>

<div class="chart-card">

<canvas id="roomChart"></canvas>

</div>

<script>

const ctx = document.getElementById("roomChart");

new Chart(ctx,{

type:'bar',

data:{

labels:[<%= rooms.map(r => `"Room ${r.room_number}"`).join(",") %>],

datasets:[{

label:"Occupied Beds",

data:[<%= rooms.map(r => r.occupied_beds).join(",") %>],

backgroundColor:[
'#2ecc71',
'#3498db',
'#f39c12',
'#e74c3c',
'#9b59b6',
'#16a085',
'#d35400'
]

}]

},

options:{

responsive:true,

plugins:{
legend:{display:false}
},

scales:{
y:{
beginAtZero:true
}
},

animation:{
duration:2000
}

}

});

</script>

</body>

</html>