<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | Rahma Pearl Girls PG</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            background:linear-gradient(135deg,#6c5ce7,#8e44ad);
            font-family:Arial,Helvetica,sans-serif;
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            padding:30px;
        }

        .contact-card{
            background:#fff;
            border-radius:20px;
            overflow:hidden;
            box-shadow:0 15px 40px rgba(0,0,0,.2);
        }

        .info-side{
            background:linear-gradient(135deg,#6c5ce7,#8e44ad);
            color:#fff;
            padding:45px;
            height:100%;
        }

        .form-side{
            padding:45px;
        }

        .info-item{
            display:flex;
            margin-bottom:25px;
        }

        .info-item i{
            font-size:22px;
            margin-right:15px;
            margin-top:5px;
        }

        .form-control{
            border-radius:10px;
            padding:12px;
        }

        .btn-submit{
            background:#6c5ce7;
            color:#fff;
            border:none;
            padding:12px;
            border-radius:10px;
            font-weight:bold;
        }

        .btn-submit:hover{
            background:#5a4cd6;
            color:white;
        }

        .social-icons{
            display:flex;
            gap:15px;
            margin-top:20px;
        }

        .social-icons a{
            width:50px;
            height:50px;
            border-radius:50%;
            display:flex;
            justify-content:center;
            align-items:center;
            background:rgba(255,255,255,.15);
            color:white;
            text-decoration:none;
            transition:.3s;
            font-size:20px;
        }

        .social-icons a:hover{
            background:white;
            color:#6c5ce7;
            transform:translateY(-5px);
        }

        .alert{
            border-radius:10px;
        }
    </style>
</head>
<body>

<div class="container">

    <div class="contact-card">

        <div class="row g-0">

            <!-- LEFT SIDE -->

            <div class="col-md-5 info-side">

                <h2 class="mb-4">Contact Information</h2>

                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <strong>Address</strong><br>
                        Rahma Pearl Girls PG<br>
                        Rajaji Nagar 2nd Cross,<br>
                        Sattur, Dharwad,<br>
                        Karnataka
                    </div>
                </div>

                <div class="info-item">
                    <i class="fas fa-phone"></i>
                    <div>
                        +91 9945786031
                    </div>
                </div>

                <div class="info-item">
                    <i class="fas fa-envelope"></i>
                    <div>
                        rahmapearlpg@gmail.com
                    </div>
                </div>

                <h5 class="mt-4">Follow Us</h5>

                <div class="social-icons">

                    <a href="https://www.facebook.com/RahmaPearlpg"
                       target="_blank">
                        <i class="fab fa-facebook-f"></i>
                    </a>

                    <a href="https://www.instagram.com/rahmapearpg"
                       target="_blank">
                        <i class="fab fa-instagram"></i>
                    </a>

                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="col-md-7 form-side">

                <h2 class="mb-4">Send Us a Message</h2>

                <% if(typeof success !== 'undefined'){ %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                <% } %>

                <% if(typeof error !== 'undefined'){ %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/contact" method="POST">

                    <div class="mb-3">

                        <label class="form-label">Full Name</label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Email</label>

                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Phone</label>

                        <input
                            type="text"
                            name="phone"
                            class="form-control">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Message</label>

                        <textarea
                            name="message"
                            rows="5"
                            class="form-control"
                            required></textarea>

                    </div>

                    <button
                        type="submit"
                        class="btn btn-submit w-100">

                        <i class="fas fa-paper-plane"></i>
                        Send Message

                    </button>

                </form>

                <div class="text-center mt-4">
                    <a href="/" class="text-decoration-none">
                        ← Back to Home
                    </a>
                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>