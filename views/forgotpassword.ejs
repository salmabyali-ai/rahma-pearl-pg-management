<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
</head>
<body>

<h2>Forgot Password</h2>

<form action="/forgotpassword" method="POST">

    <input
        type="email"
        name="email"
        placeholder="Enter your email"
        required
    >

    <br><br>

    <button type="submit">
        Send OTP
    </button>

</form>

</body>
</html>