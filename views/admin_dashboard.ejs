<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Dashboard - Rahma Pearl PG</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body{
  background:#0f172a;
  color:white;
  font-family: 'Segoe UI';
}

.card{
  border-radius:15px;
  background:linear-gradient(135deg,#1e293b,#334155);
  color:white;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
}

.sidebar{
  background:#020617;
}

.chart-box{
  background:#1e293b;
  border-radius:15px;
}

.room-box{
  border-radius:8px;
  font-weight:bold;
}
</style>

</head>

<body>

<div class="sidebar">
<h4 class="text-center">Rahma Pearl PG</h4>
<a href="/admin/dashboard">Dashboard</a>
<a href="/admin/students">Students</a>
<a href="/admin/complaints">Complaints</a>
<a href="/admin/expenses">Expenses</a>
<a href="/admin/room-status">Room</a>
<a href="/admin/food-menu">Food</a>
<a href="/admin/staff">Staff</a>
<a href="/admin/visitors">Visitors</a>
<a href="/admin/guest-students">Guest Mess Students</a>
<a href="/admin/mess-attendance">View Mess Attendance</a>
<a href="/logout">Logout</a>
</div>
<nav class="navbar bg-white shadow-sm" style="margin-left:230px;">
<div class="container-fluid">
<span>Welcome Admin 👋</span>
</div>
</nav>
</body>
<div class="main">

<h2>Dashboard</h2>
<p id="clock"></p>

<div class="row">

<div class="col-md-3">
<div class="card p-3 text-center dashboard-card">
<h5>Total Students</h5>
<h3><%= totalStudents %></h3>
</div>
</div>

<div class="col-md-3">
<div class="card p-3 text-center dashboard-card">
<h5>Total Mess</h5>
<h3><%= totalMess %></h3>
</div>
</div>

<div class="col-md-3">
<div class="card p-3 text-center dashboard-card">
<h5>Total Rooms</h5>
<h3><%= totalRooms %></h3>
</div>
</div>

<div class="col-md-3">
<div class="card p-3 text-center dashboard-card">
<h5>Total Income</h5>
<h3>₹ <%= totalIncome %></h3>
</div>
</div>

<div class="col-md-3">
<div class="card p-3 text-center dashboard-card">
<h5>Profit</h5>
<h3>₹ <%= (totalIncome || 0) - (totalExpense || 0) %></h3>
</div>
</div>

</div>

<!-- Chart -->
<div class="chart-box">
<h5>Finance</h5>
<canvas id="financeChart"></canvas>
</div>

<!-- Room Chart -->
<div class="chart-box">
<h5>Rooms</h5>
<canvas id="roomChart"></canvas>
</div>

<!-- Room Heatmap -->
<div class="chart-box">
<h5>Room Status</h5>

<div class="row">

<% (rooms || []).forEach(room => { %>

<div class="col-md-2 mb-2">
    <div class="room-box <%= room.occupied ? 'bg-danger' : 'bg-success' %>"></div>
</div>
</div>

<% }) %>

</div>

</div>

<!-- Activity -->
<div class="chart-box">
<h5>Activity</h5>

<ul class="list-group">

<% (activities || []).forEach(a => { %>

<li class="list-group-item">
<b><%= a.student_name %></b> - <%= a.action %>
<span class="float-end"><%= a.date %></span>
</li>

<% }) %>

</ul>

</div>

</div>

<script>

const income = <%= totalIncome || 0 %>;
const expense = <%= totalExpense || 0 %>;

new Chart(document.getElementById("financeChart"),{
type:"bar",
data:{
labels:["Income","Expense"],
datasets:[{
data:[income,expense],
backgroundColor:["green","red"]
}]
}
});

const totalRooms = <%= totalRooms %>;
const occupiedRooms = <%= occupiedRooms %>;

new Chart(document.getElementById("roomChart"),{
type:"doughnut",
data:{
labels:["Occupied","Available"],
datasets:[{
data:[occupiedRooms,totalRooms-occupiedRooms]
}]
}
});

function updateClock(){
const now=new Date();
document.getElementById("clock").innerHTML=now.toLocaleString();
}
setInterval(updateClock,1000);
</script>

<!-- your dashboard HTML above -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
let financeChart;

async function loadData(){

  const res = await fetch("/admin/live-data");
  const data = await res.json();

  // Update cards
  document.getElementById("income").innerText = "₹ " + data.income;
  document.getElementById("students").innerText = data.students;

  const profit = data.income - data.expense;
  document.getElementById("profit").innerText = "₹ " + profit;

  // Chart update
  if(financeChart){
    financeChart.data.datasets[0].data = [data.income, data.expense];
    financeChart.update();
  }
}

// Chart init
financeChart = new Chart(document.getElementById("financeChart"),{
  type:"line",
  data:{
    labels:["Income","Expense"],
    datasets:[{
      label:"Finance",
      data:[0,0],
      borderWidth:3,
      tension:0.4
    }]
  }
});

// Auto refresh
setInterval(loadData,5000);

// First load
loadData();
</script>

</body>
</html>