<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Dashboard | Rahma Pearl Girls PG</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

/* =====================================================
   GLOBAL
===================================================== */

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:#0f172a;
    color:#e5e7eb;
    font-family:"Segoe UI",Arial,sans-serif;
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar{

    position:fixed;

    top:0;
    left:0;

    width:250px;
    height:100vh;

    background:
        linear-gradient(
            180deg,
            #020617,
            #111827
        );

    border-right:1px solid rgba(255,255,255,.08);

    padding:20px 14px;

    z-index:1000;

    overflow-y:auto;
}


/* LOGO */

.logo-area{

    text-align:center;

    padding-bottom:20px;

    margin-bottom:15px;

    border-bottom:1px solid rgba(255,255,255,.08);
}


.logo-area img{

    width:72px;
    height:72px;

    object-fit:contain;

    background:white;

    padding:5px;

    border-radius:18px;

    box-shadow:
        0 8px 25px rgba(0,0,0,.35);

}


.logo-name{

    margin-top:10px;

    font-size:20px;

    font-weight:800;

    letter-spacing:1px;

    color:white;
}


.logo-subtitle{

    font-size:10px;

    letter-spacing:2px;

    color:#c4b5fd;

}


/* NAVIGATION */

.sidebar a{

    display:flex;

    align-items:center;

    gap:12px;

    padding:12px 14px;

    margin:5px 0;

    border-radius:10px;

    color:#cbd5e1;

    text-decoration:none;

    font-size:14px;

    transition:.25s;
}


.sidebar a i{

    width:20px;

    text-align:center;

    color:#a78bfa;
}


.sidebar a:hover{

    background:
        linear-gradient(
            90deg,
            #4f46e5,
            #6d28d9
        );

    color:white;

    transform:translateX(3px);
}


.sidebar a:hover i{

    color:white;
}


.logout-link{

    margin-top:20px !important;

    color:#fca5a5 !important;
}


.logout-link i{

    color:#f87171 !important;
}


/* =====================================================
   TOP NAVBAR
===================================================== */

.topbar{

    position:fixed;

    top:0;
    left:250px;
    right:0;

    height:72px;

    background:
        rgba(15,23,42,.95);

    backdrop-filter:blur(12px);

    border-bottom:1px solid rgba(255,255,255,.08);

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 30px;

    z-index:900;
}


.welcome{

    font-size:18px;

    font-weight:600;

    color:white;
}


.welcome span{

    color:#a78bfa;
}


.live-status{

    display:flex;

    align-items:center;

    gap:8px;

    font-size:12px;

    color:#86efac;
}


.live-dot{

    width:8px;
    height:8px;

    border-radius:50%;

    background:#22c55e;

    box-shadow:
        0 0 10px #22c55e;
}


/* =====================================================
   MAIN
===================================================== */

.main{

    margin-left:250px;

    padding:105px 30px 40px;

    min-height:100vh;
}


/* =====================================================
   PAGE TITLE
===================================================== */

.page-title{

    margin-bottom:25px;
}


.page-title h2{

    font-size:30px;

    font-weight:800;

    margin:0;

    color:white;
}


.page-title p{

    color:#94a3b8;

    margin:6px 0 0;

    font-size:13px;
}


/* =====================================================
   DASHBOARD CARDS
===================================================== */

.dashboard-card{

    position:relative;

    overflow:hidden;

    border:none;

    border-radius:18px;

    min-height:145px;

    padding:22px;

    background:
        linear-gradient(
            145deg,
            #1e293b,
            #334155
        );

    box-shadow:
        0 10px 30px rgba(0,0,0,.25);

    transition:.3s;
}


.dashboard-card:hover{

    transform:translateY(-5px);

    box-shadow:
        0 18px 40px rgba(0,0,0,.35);
}


.dashboard-card::after{

    content:"";

    position:absolute;

    width:100px;
    height:100px;

    border-radius:50%;

    right:-35px;
    top:-35px;

    background:rgba(255,255,255,.04);
}


.card-icon{

    width:45px;
    height:45px;

    border-radius:12px;

    display:flex;

    align-items:center;
    justify-content:center;

    background:rgba(167,139,250,.15);

    color:#c4b5fd;

    font-size:18px;

    margin-bottom:12px;
}


.dashboard-card h6{

    color:#94a3b8;

    font-size:12px;

    text-transform:uppercase;

    letter-spacing:.8px;

    margin:0 0 6px;
}


.dashboard-card h3{

    margin:0;

    color:white;

    font-size:25px;

    font-weight:800;
}


/* =====================================================
   SECTION BOX
===================================================== */

.section-box{

    background:#1e293b;

    border-radius:18px;

    padding:22px;

    margin-top:25px;

    box-shadow:
        0 10px 30px rgba(0,0,0,.20);

    border:1px solid rgba(255,255,255,.05);
}


.section-title{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:20px;
}


.section-title h5{

    margin:0;

    color:white;

    font-weight:700;
}


.section-title i{

    color:#a78bfa;

    margin-right:7px;
}


/* =====================================================
   CHART
===================================================== */

.chart-container{

    position:relative;

    height:300px;
}


/* =====================================================
   ROOM HEATMAP
===================================================== */

.room-box{

    min-height:85px;

    border-radius:13px;

    padding:12px;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    font-weight:700;

    border:1px solid rgba(255,255,255,.08);

    transition:.25s;
}


.room-box:hover{

    transform:scale(1.04);
}


.room-number{

    font-size:16px;
}


.room-status{

    font-size:10px;

    margin-top:4px;

    opacity:.85;
}


.room-occupied{

    background:
        linear-gradient(
            135deg,
            #dc2626,
            #991b1b
        );

    color:white;
}


.room-available{

    background:
        linear-gradient(
            135deg,
            #16a34a,
            #166534
        );

    color:white;
}


/* =====================================================
   ACTIVITY
===================================================== */

.activity-list{

    list-style:none;

    padding:0;

    margin:0;
}


.activity-item{

    display:flex;

    align-items:center;

    gap:14px;

    padding:14px 0;

    border-bottom:1px solid rgba(255,255,255,.07);
}


.activity-item:last-child{

    border-bottom:none;
}


.activity-icon{

    width:38px;
    height:38px;

    border-radius:50%;

    display:flex;

    align-items:center;
    justify-content:center;

    background:#312e81;

    color:#c4b5fd;
}


.activity-content{

    flex:1;
}


.activity-content strong{

    color:white;

    font-size:13px;
}


.activity-content span{

    display:block;

    color:#94a3b8;

    font-size:12px;

    margin-top:2px;
}


.activity-date{

    color:#64748b;

    font-size:11px;
}


/* =====================================================
   MOBILE
===================================================== */

.mobile-menu{

    display:none;

}


@media(max-width:900px){

    .sidebar{

        width:220px;
    }

    .topbar{

        left:220px;
    }

    .main{

        margin-left:220px;
    }

}


@media(max-width:700px){

    .sidebar{

        width:0;

        padding:0;

        overflow:hidden;
    }

    .topbar{

        left:0;

        padding:0 18px;
    }

    .main{

        margin-left:0;

        padding:95px 15px 30px;
    }

    .mobile-menu{

        display:block;

        background:none;

        border:none;

        color:white;

        font-size:20px;
    }

}


/* =====================================================
   SIDEBAR MOBILE OPEN
===================================================== */

.sidebar.show{

    width:250px;

    padding:20px 14px;

}


/* =====================================================
   SCROLLBAR
===================================================== */

::-webkit-scrollbar{

    width:6px;
}


::-webkit-scrollbar-thumb{

    background:#475569;

    border-radius:10px;
}

</style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<div class="sidebar" id="sidebar">


    <div class="logo-area">

        <img
            src="/images/pg-logo.png"
            alt="Rahma Pearl Girls PG"
        >

        <div class="logo-name">

            RAHMA PEARL

        </div>

        <div class="logo-subtitle">

            GIRLS PG • HUBLI

        </div>

    </div>


    <a href="/admin/dashboard">

        <i class="fas fa-chart-pie"></i>

        Dashboard

    </a>


    <a href="/admin/students">

        <i class="fas fa-users"></i>

        Students

    </a>


    <a href="/admin/complaints">

        <i class="fas fa-comments"></i>

        Complaints

    </a>


    <a href="/admin/expenses">

        <i class="fas fa-wallet"></i>

        Expenses

    </a>


    <a href="/admin/room-status">

        <i class="fas fa-bed"></i>

        Rooms

    </a>


    <a href="/admin/food-menu">

        <i class="fas fa-utensils"></i>

        Food Menu

    </a>


    <a href="/admin/staff">

        <i class="fas fa-user-tie"></i>

        Staff

    </a>


    <a href="/admin/visitors">

        <i class="fas fa-id-card"></i>

        Visitors

    </a>


    <a href="/admin/guest-students">

        <i class="fas fa-user-group"></i>

        Guest Mess Students

    </a>


    <a href="/admin/mess-attendance">

        <i class="fas fa-clipboard-check"></i>

        Mess Attendance

    </a>


    <a
        href="/logout"
        class="logout-link"
    >

        <i class="fas fa-right-from-bracket"></i>

        Logout

    </a>

</div>



<!-- =====================================================
     TOPBAR
===================================================== -->

<nav class="topbar">


    <div>

        <button
            class="mobile-menu"
            onclick="toggleSidebar()"
        >

            <i class="fas fa-bars"></i>

        </button>

        <span class="welcome">

            Welcome,
            <span>Admin</span> 👋

        </span>

    </div>


    <div class="live-status">

        <span class="live-dot"></span>

        System Online

    </div>

</nav>



<!-- =====================================================
     MAIN CONTENT
===================================================== -->

<div class="main">


    <!-- TITLE -->

    <div class="page-title">

        <h2>

            Admin Dashboard

        </h2>

        <p id="clock">

            Loading time...

        </p>

    </div>



    <!-- =================================================
         STAT CARDS
    ================================================== -->

    <div class="row g-4">


        <!-- STUDENTS -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card">

                <div class="card-icon">

                    <i class="fas fa-users"></i>

                </div>

                <h6>Total Students</h6>

                <h3 id="students">

                    <%= totalStudents || 0 %>

                </h3>

            </div>

        </div>


        <!-- MESS -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card">

                <div class="card-icon">

                    <i class="fas fa-utensils"></i>

                </div>

                <h6>Total Mess</h6>

                <h3>

                    <%= totalMess || 0 %>

                </h3>

            </div>

        </div>


        <!-- ROOMS -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card">

                <div class="card-icon">

                    <i class="fas fa-bed"></i>

                </div>

                <h6>Total Rooms</h6>

                <h3>

                    <%= totalRooms || 0 %>

                </h3>

            </div>

        </div>


        <!-- INCOME -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card">

                <div class="card-icon">

                    <i class="fas fa-indian-rupee-sign"></i>

                </div>

                <h6>Total Income</h6>

                <h3 id="income">

                    ₹ <%= totalIncome || 0 %>

                </h3>

            </div>

        </div>


        <!-- PROFIT -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card">

                <div class="card-icon">

                    <i class="fas fa-chart-line"></i>

                </div>

                <h6>Profit</h6>

                <h3 id="profit">

                    ₹ <%= (totalIncome || 0) - (totalExpense || 0) %>

                </h3>

            </div>

        </div>


    </div>



    <!-- =================================================
         FINANCE + ROOM CHART
    ================================================== -->

    <div class="row g-4">


        <!-- FINANCE -->

        <div class="col-lg-7">

            <div class="section-box">

                <div class="section-title">

                    <h5>

                        <i class="fas fa-chart-column"></i>

                        Financial Overview

                    </h5>

                </div>


                <div class="chart-container">

                    <canvas id="financeChart"></canvas>

                </div>

            </div>

        </div>


        <!-- ROOMS -->

        <div class="col-lg-5">

            <div class="section-box">

                <div class="section-title">

                    <h5>

                        <i class="fas fa-chart-pie"></i>

                        Room Overview

                    </h5>

                </div>


                <div class="chart-container">

                    <canvas id="roomChart"></canvas>

                </div>

            </div>

        </div>


    </div>



    <!-- =================================================
         ROOM STATUS
    ================================================== -->

    <div class="section-box">

        <div class="section-title">

            <h5>

                <i class="fas fa-bed"></i>

                Room Status

            </h5>

        </div>


        <div class="row g-3">

            <% (rooms || []).forEach(room => { %>


                <div class="col-6 col-md-3 col-lg-2">

                    <div class="room-box <%= room.occupied ? 'room-occupied' : 'room-available' %>">

                        <div class="room-number">

                            Room <%= room.room_number %>

                        </div>


                        <div class="room-status">

                            <%= room.occupied ? 'Occupied' : 'Available' %>

                        </div>

                    </div>

                </div>


            <% }) %>


            <% if (!(rooms || []).length) { %>

                <div class="col-12">

                    <div class="text-center text-secondary py-4">

                        No room information available.

                    </div>

                </div>

            <% } %>

        </div>

    </div>



    <!-- =================================================
         ACTIVITY
    ================================================== -->

    <div class="section-box">

        <div class="section-title">

            <h5>

                <i class="fas fa-clock-rotate-left"></i>

                Recent Activity

            </h5>

        </div>


        <ul class="activity-list">


            <% (activities || []).forEach(a => { %>


                <li class="activity-item">


                    <div class="activity-icon">

                        <i class="fas fa-user"></i>

                    </div>


                    <div class="activity-content">

                        <strong>

                            <%= a.student_name || 'Student' %>

                        </strong>


                        <span>

                            <%= a.action || 'Activity recorded' %>

                        </span>

                    </div>


                    <div class="activity-date">

                        <%= a.date || '' %>

                    </div>


                </li>


            <% }) %>


            <% if (!(activities || []).length) { %>

                <li class="text-center text-secondary py-4">

                    No recent activity.

                </li>

            <% } %>


        </ul>

    </div>


</div>



<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

/* =====================================================
   CLOCK
===================================================== */

function updateClock(){

    const now = new Date();

    const clock =
        document.getElementById("clock");

    if(clock){

        clock.innerText =
            now.toLocaleString();

    }

}

updateClock();

setInterval(
    updateClock,
    1000
);


/* =====================================================
   INITIAL DATA
===================================================== */

const initialIncome =
    Number(<%= totalIncome || 0 %>);

const initialExpense =
    Number(<%= totalExpense || 0 %>);

const totalRooms =
    Number(<%= totalRooms || 0 %>);

const occupiedRooms =
    Number(<%= occupiedRooms || 0 %>);


/* =====================================================
   FINANCE CHART
===================================================== */

const financeCtx =
    document
        .getElementById("financeChart")
        .getContext("2d");


let financeChart =
    new Chart(
        financeCtx,
        {

            type:"bar",

            data:{

                labels:[
                    "Income",
                    "Expense"
                ],

                datasets:[{

                    label:"Amount",

                    data:[
                        initialIncome,
                        initialExpense
                    ],

                    borderWidth:0,

                    borderRadius:8

                }]

            },

            options:{

                responsive:true,

                maintainAspectRatio:false,

                plugins:{

                    legend:{
                        display:false
                    }

                },

                scales:{

                    x:{
                        ticks:{
                            color:"#94a3b8"
                        },

                        grid:{
                            display:false
                        }
                    },

                    y:{

                        ticks:{
                            color:"#94a3b8"
                        },

                        grid:{
                            color:
                                "rgba(255,255,255,.06)"
                        }

                    }

                }

            }

        }
    );


/* =====================================================
   ROOM CHART
===================================================== */

const roomCtx =
    document
        .getElementById("roomChart")
        .getContext("2d");


new Chart(

    roomCtx,

    {

        type:"doughnut",

        data:{

            labels:[
                "Occupied",
                "Available"
            ],

            datasets:[{

                data:[

                    occupiedRooms,

                    Math.max(
                        totalRooms - occupiedRooms,
                        0
                    )

                ],

                borderWidth:0

            }]

        },

        options:{

            responsive:true,

            maintainAspectRatio:false,

            cutout:"70%",

            plugins:{

                legend:{

                    position:"bottom",

                    labels:{

                        color:"#cbd5e1",

                        padding:18

                    }

                }

            }

        }

    }

);


/* =====================================================
   LIVE DATA
===================================================== */

async function loadData(){

    try{

        const response =
            await fetch(
                "/admin/live-data",
                {
                    cache:"no-store"
                }
            );


        if(!response.ok){

            throw new Error(
                "Live data request failed"
            );

        }


        const data =
            await response.json();


        /* STUDENTS */

        const students =
            document.getElementById("students");


        if(students){

            students.innerText =
                data.students ?? 0;

        }


        /* INCOME */

        const income =
            Number(data.income || 0);


        const incomeElement =
            document.getElementById("income");


        if(incomeElement){

            incomeElement.innerText =
                "₹ " + income;

        }


        /* PROFIT */

        const expense =
            Number(data.expense || 0);


        const profit =
            income - expense;


        const profitElement =
            document.getElementById("profit");


        if(profitElement){

            profitElement.innerText =
                "₹ " + profit;

        }


        /* CHART */

        if(financeChart){

            financeChart
                .data
                .datasets[0]
                .data = [
                    income,
                    expense
                ];

            financeChart.update();

        }

    }

    catch(error){

        console.error(
            "Live dashboard error:",
            error
        );

    }

}


/* FIRST LOAD */

loadData();


/* REFRESH EVERY 5 SECONDS */

setInterval(
    loadData,
    5000
);


/* =====================================================
   MOBILE SIDEBAR
===================================================== */

function toggleSidebar(){

    const sidebar =
        document.getElementById("sidebar");

    sidebar.classList.toggle("show");

}

</script>


</body>

</html>