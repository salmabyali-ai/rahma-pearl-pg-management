<!DOCTYPE html>
<html>

<head>

<title>Weekly Food Menu</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:#f5f6fa;
}

.card{
border-radius:10px;
box-shadow:0 5px 10px rgba(0,0,0,0.1);
}

</style>

</head>

<body>

<div class="container mt-4">

<h3 class="text-center">PG Weekly Food Menu</h3>

<br>

<% menu.forEach(item => { %>

<div class="card mb-3">

<div class="card-body">

<h5><%= item.day %></h5>

<p><b>Breakfast:</b> <%= item.breakfast %></p>

<p><i class="fas fa-utensils"></i> <b>Lunch:</b> <%= item.lunch %></p>

<p><b>Dinner:</b> <%= item.dinner %></p>

</div>

</div>

<% }) %>

</div>

</body>

</html>