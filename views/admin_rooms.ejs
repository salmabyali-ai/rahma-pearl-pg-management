<!DOCTYPE html>
<html>

<head>

<title>Room Management</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body style="background:#f5f6fa">

<div class="container mt-4">

<h2>Room Management</h2>

<hr>

<h4>Add New Room</h4>

<form action="/admin/rooms/add" method="POST">

<div class="row">

<div class="col-md-3">
<input type="text" name="room_number" class="form-control" placeholder="Room Number" required>
</div>

<div class="col-md-3">
<input type="number" name="capacity" class="form-control" placeholder="Capacity" required>
</div>

<div class="col-md-3">
<input type="number" name="price" class="form-control" placeholder="Rent Amount" required>
</div>

<div class="col-md-3">
<button class="btn btn-primary">Add Room</button>
</div>

</div>

</form>

<br>

<h4>Room List</h4>

<table class="table table-bordered">

<tr>
<th>ID</th>
<th>Room Number</th>
<th>Capacity</th>
<th>Rent</th>
<th>Action</th>
</tr>

<% rooms.forEach(room => { %>

<tr>

<td><%= room.id %></td>

<td><%= room.room_number %></td>

<td><%= room.capacity %></td>

<td>₹<%= room.price %></td>

<td>

<a href="/admin/rooms/edit/<%= room.id %>" 
class="btn btn-warning btn-sm">
Edit
</a>

<form action="/admin/rooms/delete/<%= room.id %>" 
method="POST" 
style="display:inline">

<button class="btn btn-danger btn-sm">
Delete
</button>

</form>

</td>

</tr>

<% }) %>

</table>

</div>

</body>

</html>