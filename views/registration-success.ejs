<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Registration Successful | Rahma Pearl PG
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;

            background:
                radial-gradient(
                    circle at top left,
                    rgba(255, 209, 102, 0.16),
                    transparent 32%
                ),
                linear-gradient(
                    135deg,
                    #062d32,
                    #087f73
                );

            color: #ffffff;
        }

        .page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            padding: 18px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;

            background: rgba(0, 0, 0, 0.18);
            border-bottom:
                1px solid rgba(255, 255, 255, 0.12);

            backdrop-filter: blur(12px);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;

            color: #ffffff;
            text-decoration: none;
            font-size: 24px;
            font-weight: 800;
        }

        .brand-icon {
            width: 48px;
            height: 48px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    #ffd166,
                    #f4a261
                );

            color: #153b3b;

            box-shadow:
                0 8px 22px rgba(255, 209, 102, 0.3);
        }

        .nav-login {
            padding: 10px 19px;

            border-radius: 10px;
            border:
                1px solid rgba(255, 255, 255, 0.35);

            color: #ffffff;
            text-decoration: none;
            font-weight: 700;

            transition: 0.3s;
        }

        .nav-login:hover {
            background: #ffffff;
            color: #087f73;
        }

        .main-section {
            flex: 1;

            display: flex;
            align-items: center;

            padding: 55px 7%;
        }

        .success-card {
            width: 100%;
            max-width: 1160px;

            margin: auto;
            overflow: hidden;

            border-radius: 28px;

            background: rgba(255, 255, 255, 0.98);
            color: #173333;

            box-shadow:
                0 25px 70px rgba(0, 0, 0, 0.3);

            animation: cardEntry 0.7s ease;
        }

        @keyframes cardEntry {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .success-left {
            min-height: 100%;
            padding: 48px 42px;
            text-align: center;

            background:
                linear-gradient(
                    160deg,
                    #ffffff,
                    #ecfaf7
                );
        }

        .success-icon {
            width: 100px;
            height: 100px;

            margin: 0 auto 23px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #1abc9c,
                    #087f73
                );

            color: #ffffff;
            font-size: 48px;

            box-shadow:
                0 14px 35px rgba(26, 188, 156, 0.35);

            animation: iconPop 0.8s ease;
        }

        @keyframes iconPop {
            0% {
                opacity: 0;
                transform: scale(0.4);
            }

            70% {
                transform: scale(1.1);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .success-left h1 {
            margin-bottom: 12px;

            color: #0b6159;
            font-size: 35px;
            font-weight: 800;
        }

        .welcome-text {
            margin-bottom: 22px;

            color: #526666;
            font-size: 17px;
            line-height: 1.7;
        }

        .student-name {
            color: #087f73;
            font-weight: 800;
        }

        .type-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 18px;
            padding: 9px 17px;

            border-radius: 100px;

            background: #ddf7f2;
            color: #087f73;

            font-size: 14px;
            font-weight: 800;
        }

        .registration-info {
            margin: 20px 0;
            padding: 17px;

            text-align: left;

            background: #f1f9f7;
            border: 1px solid #d7eeea;
            border-radius: 16px;
        }

        .registration-info p {
            margin: 8px 0;
            color: #425959;
            word-break: break-word;
        }

        .registration-info i {
            width: 27px;
            color: #0b8a7d;
        }

        .status-box {
            margin-bottom: 24px;
            padding: 16px;

            text-align: left;

            color: #725400;
            background: #fff7dc;

            border: 1px solid #f7df8b;
            border-radius: 14px;
        }

        .status-heading {
            display: flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 8px;
            font-weight: 800;
        }

        .status-message {
            margin: 0;
            line-height: 1.6;
        }

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }

        .btn-login,
        .btn-home {
            padding: 13px 26px;

            border-radius: 12px;

            font-weight: 700;
            text-decoration: none;

            transition: 0.3s;
        }

        .btn-login {
            border: none;

            background:
                linear-gradient(
                    135deg,
                    #0e9f8d,
                    #087f73
                );

            color: #ffffff;
        }

        .btn-login:hover {
            color: #ffffff;
            transform: translateY(-2px);

            box-shadow:
                0 10px 24px rgba(8, 127, 115, 0.28);
        }

        .btn-home {
            border: 1px solid #0e9f8d;

            background: transparent;
            color: #087f73;
        }

        .btn-home:hover {
            background: #e6f8f5;
            color: #075f57;
            transform: translateY(-2px);
        }

        .countdown {
            margin-top: 17px;

            color: #617575;
            font-size: 14px;
        }

        .countdown span {
            color: #087f73;
            font-weight: 800;
        }

        .features-side {
            height: 100%;
            padding: 47px 42px;

            background:
                linear-gradient(
                    145deg,
                    #0b776c,
                    #064d49
                );

            color: #ffffff;
        }

        .small-heading {
            display: inline-block;

            margin-bottom: 11px;
            padding: 7px 13px;

            border-radius: 100px;

            background: rgba(255, 209, 102, 0.15);
            border:
                1px solid rgba(255, 209, 102, 0.35);

            color: #ffd166;
            font-size: 13px;
            font-weight: 800;
        }

        .features-side h2 {
            margin-bottom: 12px;

            font-size: 30px;
            font-weight: 800;
        }

        .features-intro {
            margin-bottom: 25px;

            color: rgba(255, 255, 255, 0.82);
            line-height: 1.7;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;

            margin-bottom: 12px;
            padding: 14px;

            border-radius: 15px;

            background: rgba(255, 255, 255, 0.09);
            border:
                1px solid rgba(255, 255, 255, 0.12);

            transition: 0.3s;
        }

        .feature-item:hover {
            transform: translateX(5px);
            background: rgba(255, 255, 255, 0.15);
        }

        .feature-icon {
            min-width: 44px;
            height: 44px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: #ffd166;
            color: #134944;

            font-size: 18px;
        }

        .feature-item h5 {
            margin: 0 0 4px;

            font-size: 16px;
            font-weight: 700;
        }

        .feature-item p {
            margin: 0;

            color: rgba(255, 255, 255, 0.76);
            font-size: 13px;
            line-height: 1.5;
        }

        .highlight-box {
            margin-top: 18px;
            padding: 16px;

            border-radius: 14px;

            background: rgba(255, 209, 102, 0.12);
            border:
                1px solid rgba(255, 209, 102, 0.3);

            color: #fff1bf;
        }

        .highlight-box strong {
            display: block;
            margin-bottom: 4px;
            color: #ffd166;
        }

        .footer {
            padding: 18px;
            text-align: center;

            color: rgba(255, 255, 255, 0.7);
        }

        @media (max-width: 991px) {
            .main-section {
                padding: 35px 15px;
            }

            .success-left,
            .features-side {
                padding: 38px 25px;
            }

            .success-left h1 {
                font-size: 29px;
            }
        }

        @media (max-width: 576px) {
            .navbar-custom {
                padding: 14px 15px;
            }

            .brand-logo {
                font-size: 19px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
            }

            .nav-login {
                display: none;
            }

            .success-left h1 {
                font-size: 25px;
            }

            .success-icon {
                width: 84px;
                height: 84px;
                font-size: 39px;
            }

            .action-buttons a {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

<div class="page-wrapper">

    <nav class="navbar-custom">

        <a href="/" class="brand-logo">

            <div class="brand-icon">
                <i class="fa-solid fa-building"></i>
            </div>

            <span>Rahma Pearl PG</span>

        </a>

        <a href="/login" class="nav-login">
            Student Login
        </a>

    </nav>

    <main class="main-section">

        <div class="success-card">

            <div class="row g-0">

                <div class="col-lg-6">

                    <section class="success-left">

                        <div class="success-icon">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <h1>Registration Successful!</h1>

                        <div class="type-badge">

                            <i class="fa-solid fa-user-check"></i>

                            <%= registrationType || "PG Student" %>

                        </div>

                        <p class="welcome-text">

                            Welcome,

                            <span class="student-name">
                                <%= studentName || "Student" %>
                            </span>!

                            <br>

                            Thank you for choosing

                            <strong>Rahma Pearl PG</strong>

                            as your trusted place to stay and study.

                        </p>

                        <div class="registration-info">

                            <p>
                                <i class="fa-solid fa-user"></i>

                                <strong>Name:</strong>

                                <%= studentName || "Student" %>
                            </p>

                            <p>
                                <i class="fa-solid fa-envelope"></i>

                                <strong>Email:</strong>

                                <%= email || "Not provided" %>
                            </p>

                            <p>
                                <i class="fa-solid fa-id-card"></i>

                                <strong>Registration:</strong>

                                <%= registrationType || "PG Student" %>
                            </p>

                            <p>
                                <i class="fa-solid fa-calendar-check"></i>

                                <strong>Registered:</strong>

                                <span id="registrationDate"></span>
                            </p>

                        </div>

                        <div class="status-box">

                            <div class="status-heading">

                                <i class="fa-solid fa-clock"></i>

                                Application Status:

                                <span>
                                    <%= approvalStatus || "Pending" %>
                                </span>

                            </div>

                            <p class="status-message">

                                <%= successMessage ||
                                "Your application has been submitted successfully." %>

                                The Rahma Pearl PG administrator will
                                verify your registration details.

                                You can sign in after your account has
                                been approved.

                            </p>

                        </div>

                        <div class="action-buttons">

                            <a href="/login" class="btn-login">

                                <i class="fa-solid fa-right-to-bracket me-2"></i>

                                Go to Login

                            </a>

                            <a href="/" class="btn-home">

                                <i class="fa-solid fa-house me-2"></i>

                                Back to Home

                            </a>

                        </div>

                        <p class="countdown">

                            Redirecting to the login page in

                            <span id="countdown">15</span>

                            seconds

                        </p>

                    </section>

                </div>

                <div class="col-lg-6">

                    <section class="features-side">

                        <span class="small-heading">
                            YOUR HOME AWAY FROM HOME
                        </span>

                        <h2>Why Students Choose Rahma Pearl PG</h2>

                        <p class="features-intro">

                            More than accommodation — Rahma Pearl PG
                            offers a comfortable, secure and supportive
                            environment for students.

                        </p>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>

                            <div>
                                <h5>Safe and Secure Living</h5>

                                <p>
                                    Student safety, responsible management
                                    and a peaceful environment are our top
                                    priorities.
                                </p>
                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="fa-solid fa-utensils"></i>
                            </div>

                            <div>
                                <h5>Fresh Home-Style Food</h5>

                                <p>
                                    Healthy and hygienic meals prepared
                                    to make students feel at home.
                                </p>
                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="fa-solid fa-wifi"></i>
                            </div>

                            <div>
                                <h5>Student-Friendly Facilities</h5>

                                <p>
                                    Comfortable rooms, Wi-Fi access and
                                    essential facilities for productive
                                    study and rest.
                                </p>
                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="fa-solid fa-broom"></i>
                            </div>

                            <div>
                                <h5>Clean and Hygienic Rooms</h5>

                                <p>
                                    Regular cleaning and proper maintenance
                                    provide a healthier living environment.
                                </p>
                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="fa-solid fa-headset"></i>
                            </div>

                            <div>
                                <h5>Quick Student Support</h5>

                                <p>
                                    Helpful management support for rooms,
                                    food, payments, maintenance and other
                                    concerns.
                                </p>
                            </div>

                        </div>

                        <div class="highlight-box">

                            <strong>
                                Study peacefully. Live comfortably.
                            </strong>

                            Join the growing student community at
                            Rahma Pearl PG.

                        </div>

                    </section>

                </div>

            </div>

        </div>

    </main>

    <footer class="footer">

        &copy;

        <span id="currentYear"></span>

        Rahma Pearl PG. All rights reserved.

    </footer>

</div>

<script>
    const currentDate = new Date();

    document.getElementById(
        "registrationDate"
    ).textContent =
        currentDate.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "long",
            year: "numeric"
        });

    document.getElementById(
        "currentYear"
    ).textContent =
        currentDate.getFullYear();

    let remainingSeconds = 15;

    const countdownElement =
        document.getElementById("countdown");

    const countdownTimer = setInterval(() => {
        remainingSeconds--;

        countdownElement.textContent =
            remainingSeconds;

        if (remainingSeconds <= 0) {
            clearInterval(countdownTimer);

            window.location.href = "/login";
        }
    }, 1000);
</script>

</body>
</html>