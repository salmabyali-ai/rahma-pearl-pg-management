<!DOCTYPE html>
<html>
<head>
    <title>Guest Mess Students</title>
    <meta charset="UTF-8">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background:#f4f6f9;
            padding:40px;
        }

        .card{
            border-radius:10px;
        }

        .btn-sm{
            margin:2px;
        }

        table th{
            background:#343a40;
            color:white;
        }
    </style>

</head>

<body>

<div class="container">

<h2 class="mb-4">Guest Mess Students</h2>

<div class="card p-4 mb-4">

<form action="/admin/guest-students/add" method="POST">

<div class="row">

<div class="col-md-6 mb-3">
<input
type="text"
name="name"
class="form-control"
placeholder="Guest Name"
required>
</div>

<div class="col-md-6 mb-3">
<input
type="text"
name="phone"
class="form-control"
placeholder="Phone"
required>
</div>

<div class="col-md-6 mb-3">
<input
type="email"
name="email"
class="form-control"
placeholder="Email"
required>
</div>

<div class="col-md-6 mb-3">
<input
type="password"
name="password"
class="form-control"
placeholder="Password"
required>
</div>

<div class="col-md-6 mb-3">
<select
name="meal_type"
class="form-select"
required>

<option value="">Select Meal</option>
<option>Breakfast</option>
<option>Lunch</option>
<option>Dinner</option>
<option>Full Day</option>

</select>
</div>

<div class="col-md-6 mb-3">
<input
type="number"
name="amount"
class="form-control"
placeholder="Mess Fee"
value="3000"
required>
</div>

<div class="col-md-6 mb-3">
<label><b>From Date</b></label>

<input
type="date"
name="from_date"
class="form-control"
required>
</div>

<div class="col-md-6 mb-3">
<label><b>To Date</b></label>

<input
type="date"
name="to_date"
class="form-control"
required>
</div>

</div>

<button class="btn btn-primary w-100">
Add Guest
</button>

</form>

</div>

<table class="table table-bordered table-striped">

<thead>

<tr>

<th>Name</th>
<th>Phone</th>
<th>Email</th>
<th>Meal</th>
<th>Amount</th>
<th>From Date</th>
<th>To Date</th>
<th>Status</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% guests.forEach(g=>{ %>

<tr>

<td><%= g.name %></td>

<td><%= g.phone %></td>

<td><%= g.email %></td>

<td><%= g.meal_type %></td>

<td>₹<%= g.amount %></td>

<td>
<%= g.from_date ? new Date(g.from_date).toLocaleDateString('en-IN') : "-" %>
</td>

<td>
<%= g.to_date ? new Date(g.to_date).toLocaleDateString('en-IN') : "-" %>
</td>

<td>

<span class="badge bg-success">
<%= g.status %>
</span>

</td>

<td>

<a
href="/admin/guest-students/edit/<%= g.id %>"
class="btn btn-primary btn-sm">

Edit

</a>

<form
action="/admin/guest-students/delete/<%= g.id %>"
method="POST"
style="display:inline;">

<button
class="btn btn-danger btn-sm"
onclick="return confirm('Delete Guest?')">

Delete

</button>

</form>

<a
href="/admin/guest-students/reminder/<%= g.id %>"
class="btn btn-warning btn-sm">

Reminder

</a>

<% if(g.approval_status=="Approved"){ %>

<span class="badge bg-success">

Approved

</span>

<% }else{ %>

<a
href="/admin/guest-students/approve/<%= g.id %>"
class="btn btn-success btn-sm">

Approve Login

</a>

<% } %>

</td>

</tr>

<% }) %>

</tbody>

</table>

<a
href="/admin/dashboard"
class="btn btn-secondary">

Back

</a>

</div>

</body>
</html>