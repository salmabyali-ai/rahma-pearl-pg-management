<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Rahma Pearl</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { background: #f8f9fa; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 100%; max-width: 400px; padding: 30px; border-radius: 15px; background: white; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-top: 5px solid #d63031; }
        .btn-admin { background-color: #d63031; color: white; border: none; }
        .btn-admin:hover { background-color: #b02424; color: white; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <i class="fas fa-user-shield fa-3x text-danger mb-2"></i>
            <h3>Admin Portal</h3>
            <p class="text-muted">Authorized Personnel Only</p>
        </div>
        <form action="/login/admin" method="POST">
            <div class="mb-3">
                <label class="form-label">Admin Email</label>
                <input type="email" name="email" class="form-control" placeholder="salmabyali@gmail.com" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn btn-admin w-100 py-2 mb-3">Secure Login</button>
            <div class="text-center">
                <a href="/login" class="text-decoration-none text-muted small"><i class="fas fa-arrow-left"></i> Change Login Type</a>
            </div>
        </form>
    </div>
</body>
</html>